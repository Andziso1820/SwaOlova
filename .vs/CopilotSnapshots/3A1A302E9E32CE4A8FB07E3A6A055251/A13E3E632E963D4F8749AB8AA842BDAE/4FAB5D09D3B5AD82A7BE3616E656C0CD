<nav class="navbar-default navbar-static-side" role="navigation">
    <div class="sidebar-collapse">
        <div class="nav-header">
            <img class="app-logo" src="~/images/swa-olova-logo.svg" alt="SWA OLOVA logo" />
            <span class="app-title">SWA OLOVA</span>
            <small class="app-subtitle">Deliveries Portal</small>
        </div>

        <ul class="nav metismenu" id="side-menu" data-menu-root="true">
            @foreach (var menuSection in menuSections)
            {
                <li class="menu-group has-submenu @(menuSection.IsActive ? "active" : string.Empty)">
                    <a href="#" class="menu-toggle" data-menu-toggle="true" aria-expanded="@(menuSection.IsActive.ToString().ToLowerInvariant())" aria-controls="menu-@menuSection.Id">
                        <i class="fa @menuSection.Icon menu-icon" aria-hidden="true"></i>
                        <span class="menu-text">@menuSection.Text</span>
                        <i class="fa fa-chevron-down menu-arrow" aria-hidden="true"></i>
                    </a>
                    <ul class="nav nav-second-level" id="menu-@menuSection.Id" data-menu-panel="true">
                        @foreach (var item in menuSection.Items)
                        {
                            <li class="@(item.IsActive ? "active" : string.Empty)">
                                <a href="@item.Href">@item.Text</a>
                            </li>
                        }
                    </ul>
                </li>
            }
        </ul>
    </div>
</nav>
