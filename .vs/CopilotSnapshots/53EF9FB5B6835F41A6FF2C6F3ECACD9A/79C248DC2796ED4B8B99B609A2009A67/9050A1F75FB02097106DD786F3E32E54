using MediatR;
using Microsoft.AspNetCore.Mvc;
using Portal.Models;
using SwaOlova.Application.Features.Merchants.Queries.GetMerchantById;
using SwaOlova.Application.Features.Merchants.Queries.GetMerchantsPaged;
using SwaOlava.Application.Features.Merchants.Commands.ApproveMerchant;
using SwaOlova.Application.Features.Merchants.Commands.SuspendMerchant;

namespace Portal.Areas.Merchants.Controllers
{
    [Area("Merchants")]
    public class MerchantsController : Controllers.BaseController
    {
        public MerchantsController(IMediator mediator) : base(mediator)
        {
        }

        public async Task<IActionResult> Index(int pageNumber = 1, int pageSize = 10)
        {
            var query = new GetMerchantsPagedQuery
            {
                PageNumber = pageNumber,
                PageSize = pageSize
            };

            var result = await Mediator.Send(query);
            return View(result);
        }

        public async Task<IActionResult> Details(Guid id)
        {
            var query = new GetMerchantByIdQuery { MerchantId = id };
            var result = await Mediator.Send(query);

            if (result == null)
                return NotFound();

            return View(result);
        }

        [HttpPost]
        public async Task<IActionResult> Approve(Guid id)
        {
            var command = new ApproveMerchantCommand { MerchantId = id };
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
                TempData["Success"] = "Merchant approved successfully.";
            else
                TempData["Error"] = "Failed to approve merchant.";

            return RedirectToAction(nameof(Details), new { id });
        }

        [HttpPost]
        public async Task<IActionResult> Suspend(Guid id, string reason = "")
        {
            var command = new SuspendMerchantCommand { MerchantId = id, Reason = reason };
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
                TempData["Success"] = "Merchant suspended successfully.";
            else
                TempData["Error"] = "Failed to suspend merchant.";

            return RedirectToAction(nameof(Details), new { id });
        }
    }
}
