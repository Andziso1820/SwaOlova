@model SwaOlova.Portal.Areas.Riders.Models.RiderDetailsViewModel

<form method="post" asp-action="UploadDocument" asp-controller="Riders" asp-route-id="@Model.Rider.Id" data-campaign-modal-form="true">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="DocumentFileName" class="form-label">Document Name</label>
        <input asp-for="DocumentFileName" class="form-control" placeholder="e.g., Insurance Certificate, Inspection Report" />
        <span asp-validation-for="DocumentFileName" class="text-danger"></span>
        <small class="text-muted d-block mt-1">Enter a descriptive name for this document</small>
    </div>

    <div class="mb-3">
        <label asp-for="DocumentFileUrl" class="form-label">Document URL</label>
        <input asp-for="DocumentFileUrl" class="form-control" placeholder="https://example.com/document.pdf" />
        <span asp-validation-for="DocumentFileUrl" class="text-danger"></span>
        <small class="text-muted d-block mt-1">Provide a complete URL to access the document</small>
    </div>

    <div class="alert alert-info mb-3">
        <strong>Note:</strong> Upload your document to a file storage service first (e.g., AWS S3, Azure Blob Storage, Google Drive), then paste the public URL here.
    </div>

    <button type="submit" class="btn btn-primary btn-sm">Add Document</button>
</form>
