@model SwaOlova.Portal.Areas.Riders.Models.RiderDetailsViewModel

<form method="post" asp-action="SetAvailability" asp-controller="Riders" asp-route-id="@Model.Rider.Id" data-campaign-modal-form="true">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="IsAvailable" class="form-label">Availability Status</label>
        <div class="d-flex align-items-center gap-3 flex-wrap mt-2">
            <div class="form-check form-check-inline mb-0">
                <input asp-for="IsAvailable" class="form-check-input" type="radio" value="true" id="IsAvailableYes" />
                <label class="form-check-label" for="IsAvailableYes">
                    <span class="fw-semibold">Available</span>
                    <div class="text-muted small">Rider can accept new deliveries</div>
                </label>
            </div>
            <div class="form-check form-check-inline mb-0">
                <input asp-for="IsAvailable" class="form-check-input" type="radio" value="false" id="IsAvailableNo" />
                <label class="form-check-label" for="IsAvailableNo">
                    <span class="fw-semibold">Offline</span>
                    <div class="text-muted small">Rider will not receive delivery assignments</div>
                </label>
            </div>
        </div>
        <span asp-validation-for="IsAvailable" class="text-danger"></span>
    </div>

    <p class="text-muted small mb-0">Current status: <strong>@Model.AvailabilityLabel</strong></p>

    <button type="submit" class="btn btn-primary btn-sm mt-3">Update Availability</button>
</form>
