namespace SwaOlova.Infrastructure.Data.Seed;

public sealed class RoleSeeder
{
    private readonly RoleManager<ApplicationRole> _roleManager;
    private readonly SwaOlavaDbContext _context;

    public RoleSeeder(RoleManager<ApplicationRole> roleManager, SwaOlavaDbContext context)
    {
        _roleManager = roleManager;
        _context = context;
    }

    public async Task SeedAsync(CancellationToken cancellationToken = default)
    {
        // Define system roles with descriptions
        var systemRoles = new Dictionary<string, string>
        {
            { "SuperAdmin", "Full system access" },
            { "Admin", "Administrative access" },
            { "Dispatcher", "Dispatch management" },
            { "MerchantOwner", "Full merchant access" },
            { "MerchantManager", "Merchant management" },
            { "MerchantOperator", "Merchant operations" },
            { "Rider", "Rider operations" },
            { "Customer", "Customer access" },
            { "SupportAgent", "Support operations" },
            { "FinanceOfficer", "Finance operations" },
            { "OperationsManager", "Operations management" },
            { "ReportingUser", "Reporting access" }
        };

        foreach (var roleEntry in systemRoles)
        {
            if (await _roleManager.RoleExistsAsync(roleEntry.Key))
            {
                continue;
            }

            var role = new ApplicationRole
            {
                Name = roleEntry.Key,
                Description = roleEntry.Value,
                IsSystemRole = true
            };

            await _roleManager.CreateAsync(role);
        }

        // Seed permissions
        await SeedPermissionsAsync(cancellationToken);

        // Assign permissions to roles
        await AssignPermissionsToRolesAsync(cancellationToken);
    }

    private async Task SeedPermissionsAsync(CancellationToken cancellationToken = default)
    {
        var permissions = GetAllPermissions();

        foreach (var permission in permissions)
        {
            var existingPermission = _context.Permissions
                .FirstOrDefault(p => p.Code == permission.Code);

            if (existingPermission == null)
            {
                _context.Permissions.Add(permission);
            }
        }

        await _context.SaveChangesAsync(cancellationToken);
    }

    private async Task AssignPermissionsToRolesAsync(CancellationToken cancellationToken = default)
    {
        var rolePermissionMappings = GetRolePermissionMappings();

        foreach (var mapping in rolePermissionMappings)
        {
            foreach (var permissionCode in mapping.Value)
            {
                var existing = _context.RolePermissions
                    .FirstOrDefault(rp => rp.RoleName == mapping.Key && rp.Permission!.Code == permissionCode);

                if (existing != null)
                {
                    continue;
                }

                var permission = _context.Permissions
                    .FirstOrDefault(p => p.Code == permissionCode);

                if (permission != null)
                {
                    _context.RolePermissions.Add(new RolePermission(mapping.Key, permission.Id));
                }
            }
        }

        await _context.SaveChangesAsync(cancellationToken);
    }

