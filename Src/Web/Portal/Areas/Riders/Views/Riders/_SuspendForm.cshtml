@model SwaOlova.Portal.Areas.Riders.Models.RiderDetailsViewModel

<form method="post" asp-action="Suspend" asp-controller="Riders" asp-route-id="@Model.Rider.Id" data-campaign-modal-form="true">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="SuspendReason" class="form-label">Suspension Reason</label>
        <textarea asp-for="SuspendReason" class="form-control" rows="3" placeholder="Enter the reason for suspending this rider..."></textarea>
        <span asp-validation-for="SuspendReason" class="text-danger"></span>
    </div>

    <div class="alert alert-warning mb-3">
        <strong>Warning:</strong> Suspending <strong>@Model.Rider.FullName</strong> will prevent them from accepting new deliveries. This action can be reversed.
    </div>

    <button type="submit" class="btn btn-danger btn-sm">Suspend Rider</button>
</form>
