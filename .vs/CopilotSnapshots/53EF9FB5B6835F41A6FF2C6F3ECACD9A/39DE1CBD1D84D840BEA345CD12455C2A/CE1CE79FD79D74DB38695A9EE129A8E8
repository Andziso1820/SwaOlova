@using SwaOlova.Application.Features.Products.Queries.GetProductsPaged
@model GetProductsPagedResponse

@{
    ViewData["Title"] = "Products Management";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1>@ViewData["Title"]</h1>
            <a href="#" class="btn btn-primary"><i class="fa fa-plus"></i> Add Product</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Total Products</p>
                <h4>@Model?.Items?.Count() ?? 0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Out of Stock</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Low Stock</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Categories</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <form class="form-inline" asp-action="Search" method="post">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search products...">
                        <button type="submit" class="btn btn-info"><i class="fa fa-search"></i></button>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Merchant</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items?.Any() == true)
                        {
                            @foreach (var product in Model.Items)
                            {
                                <tr>
                                    <td><strong>@product.ProductName</strong></td>
                                    <td>@product.Category</td>
                                    <td>@product.MerchantName</td>
                                    <td>@product.Price.ToString("C")</td>
                                    <td>
                                        @if (product.StockQuantity > 0)
                                        {
                                            <span class="badge bg-success">@product.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetStatusColor(product.Status)">@product.Status</span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = product.Id })" 
                                           class="btn btn-sm btn-info" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <p class="text-muted">No products found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model?.TotalPages > 1)
            {
                <div class="card-footer">
                    <nav>
                        <ul class="pagination mb-0">
                            @if (Model.PageNumber > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = 1 })">First</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageNumber - 1 })">Previous</a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = i })">@i</a>
                                </li>
                            }

                            @if (Model.PageNumber < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageNumber + 1 })">Next</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.TotalPages })">Last</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "active" => "success",
            "inactive" => "secondary",
            "draft" => "info",
            "archived" => "dark",
            _ => "secondary"
        };
    }
}
