using Microsoft.AspNetCore.Identity;
using SwaOlova.Domain.Enums;
using SwaOlova.Infrastructure.Data.Identity;

namespace SwaOlova.Infrastructure.Data.Seed;

public sealed class AdminSeeder
{
    private readonly UserManager<ApplicationUser> _userManager;
    private readonly RoleManager<ApplicationRole> _roleManager;

    public AdminSeeder(UserManager<ApplicationUser> userManager, RoleManager<ApplicationRole> roleManager)
    {
        _userManager = userManager;
        _roleManager = roleManager;
    }

    public async Task SeedAsync(CancellationToken cancellationToken = default)
    {
        // Define seed users
        var seedUsers = new List<(string Email, string FirstName, string LastName, string Password, string Role)>
        {
            ("superadmin@swaolava.co.za", "Super", "Admin", "SuperAdmin@2024!", "SuperAdmin"),
            ("admin@swaolava.co.za", "System", "Admin", "Admin@2024!", "Admin"),
            ("dispatcher@swaolava.co.za", "Dispatch", "Manager", "Dispatcher@2024!", "Dispatcher"),
            ("support@swaolava.co.za", "Support", "Agent", "Support@2024!", "SupportAgent"),
            ("finance@swaolava.co.za", "Finance", "Officer", "Finance@2024!", "FinanceOfficer"),
            ("ops@swaolava.co.za", "Operations", "Manager", "Operations@2024!", "OperationsManager"),
        };

        foreach (var (email, firstName, lastName, password, role) in seedUsers)
        {
            var existingUser = await _userManager.FindByEmailAsync(email);
            if (existingUser is not null)
            {
                continue;
            }

            var user = new ApplicationUser
            {
                UserName = email,
                Email = email,
                EmailConfirmed = true,
                FirstName = firstName,
                LastName = lastName,
                IsActive = true,
                CreatedDate = DateTime.UtcNow,
                PhoneNumberConfirmed = true
            };

            var result = await _userManager.CreateAsync(user, password);
            if (!result.Succeeded)
            {
                continue;
            }

            // Ensure role exists before adding user to role
            if (!await _roleManager.RoleExistsAsync(role))
            {
                await _roleManager.CreateAsync(new ApplicationRole
                {
                    Name = role,
                    IsSystemRole = true
                });
            }

            await _userManager.AddToRoleAsync(user, role);
        }
    }
}
