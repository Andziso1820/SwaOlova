using SwaOlova.Application.Common.Models;
using SwaOlova.Application.Features.Orders.Commands.CancelOrder;
using SwaOlova.Application.Features.Orders.Commands.CompleteOrder;
using SwaOlova.Application.Features.Orders.Commands.CreateOrder;
using SwaOlova.Application.Features.Orders.Dtos;

namespace SwaOlova.Application.Features.Orders.Services;

/// <summary>
/// Orchestrates complex order operations involving multiple repositories and services.
/// Follows domain entity pattern as per user preferences for passing entities through layers.
/// </summary>
public interface IOrderOrchestrator
{
    /// <summary>
    /// Creates an order with validated items and customer/merchant relationships.
    /// </summary>
    /// <param name="request">Create order request containing customer, merchant, items, and delivery details</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Result with order ID on success</returns>
    Task<Result<Guid>> CreateOrderAsync(
        CreateOrderRequest request,
        CancellationToken cancellationToken);

    /// <summary>
    /// Confirms a pending order and transitions it to confirmed state.
    /// </summary>
    /// <param name="orderId">Order ID to confirm</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Result indicating success or failure</returns>
    Task<Result> ConfirmOrderAsync(
        Guid orderId,
        CancellationToken cancellationToken);

    /// <summary>
    /// Cancels an order if it's in a cancellable state.
    /// </summary>
    /// <param name="request">Cancel order request containing order ID and optional notes</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Result indicating success or failure</returns>
    Task<Result> CancelOrderAsync(
        CancelOrderRequest request,
        CancellationToken cancellationToken);

    /// <summary>
    /// Completes an order and marks it as delivered.
    /// </summary>
    /// <param name="request">Complete order request containing order ID and completion details</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Result indicating success or failure</returns>
    Task<Result> CompleteOrderAsync(
        CompleteOrderRequest request,
        CancellationToken cancellationToken);

    /// <summary>
    /// Retrieves complete order tracking information with delivery and rider details.
    /// </summary>
    /// <param name="orderId">Order ID to track</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Result with order tracking DTO on success</returns>
    Task<Result<OrderTrackingDto>> GetTrackingAsync(
        Guid orderId,
        CancellationToken cancellationToken);
}
