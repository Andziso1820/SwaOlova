using MediatR;
using SwaOlova.Application.Common.Interfaces.Repositories;
using SwaOlova.Application.Common.Models;
using SwaOlova.Application.Features.Dashboard.Dtos;

namespace SwaOlova.Application.Features.Dashboard.Queries.GetRiderDashboard;

public sealed class GetRiderDashboardQueryHandler(
    IRiderRepository riderRepository,
    IDeliveryRepository deliveryRepository)
    : IRequestHandler<GetRiderDashboardQuery, Result<RiderDashboardDto>>
{
    public async Task<Result<RiderDashboardDto>> Handle(GetRiderDashboardQuery request, CancellationToken cancellationToken)
    {
        var rider = await riderRepository.GetByIdAsync(request.RiderId, cancellationToken);

        if (rider is null)
        {
            return Result<RiderDashboardDto>.Failure($"Rider with ID '{request.RiderId}' was not found.");
        }

        // Placeholder: Aggregate rider-specific data
        var dto = new RiderDashboardDto(
            RiderId: request.RiderId,
            RiderName: rider.Name,
            CompletedDeliveries: 850,
            PendingDeliveries: 5,
            TotalEarnings: 75000m,
            AverageRating: 4.7m,
            OnTimePercentage: 96.5m);

        return Result<RiderDashboardDto>.Success(dto);
    }
}
