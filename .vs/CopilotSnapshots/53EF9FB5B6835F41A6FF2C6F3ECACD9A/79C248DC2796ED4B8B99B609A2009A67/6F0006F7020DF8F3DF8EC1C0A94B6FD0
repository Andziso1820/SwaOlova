@using SwaOlova.Application.Features.Products.Queries.GetProductById
@model GetProductByIdResponse

@{
    ViewData["Title"] = "Product Details";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Product Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Product Name:</strong></p>
                        <p>@Model.ProductName</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Category:</strong></p>
                        <p>@Model.Category</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Merchant:</strong></p>
                        <p>@Model.MerchantName</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Status:</strong></p>
                        <p><span class="badge bg-@GetStatusColor(Model.Status)">@Model.Status</span></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12">
                        <p><strong>Description:</strong></p>
                        <p>@Model.Description</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Price:</strong></p>
                        <p>@Model.Price.ToString("C")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Original Price:</strong></p>
                        <p>
                            @if (Model.OriginalPrice > Model.Price)
                            {
                                <del>@Model.OriginalPrice.ToString("C")</del>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Inventory</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Current Stock:</strong></p>
                        <p>@Model.StockQuantity units</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Minimum Stock Level:</strong></p>
                        <p>@Model.MinimumStockLevel units</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Product Image</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.ProductName" class="img-fluid" style="max-height: 250px;">
                }
                else
                {
                    <div class="bg-light p-5">
                        <p class="text-muted"><i class="fa fa-image"></i> No image available</p>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Statistics</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p class="text-muted small">Total Orders</p>
                    <h5>0</h5>
                </div>
                <div class="mb-3">
                    <p class="text-muted small">Revenue</p>
                    <h5>$0.00</h5>
                </div>
                <div>
                    <p class="text-muted small">Last Updated</p>
                    <h5>@Model.UpdatedDate?.ToString("dd MMM yyyy")</h5>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Actions</h5>
            </div>
            <div class="card-body">
                <button type="button" class="btn btn-warning btn-block mb-2">
                    <i class="fa fa-edit"></i> Edit Product
                </button>
                @if (Model.StockQuantity > 0 && Model.Status == "Active")
                {
                    <form method="post" asp-action="MarkOutOfStock" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-block mb-2" onclick="return confirm('Mark this product as out of stock?')">
                            <i class="fa fa-ban"></i> Mark Out of Stock
                        </button>
                    </form>
                }
                <button type="button" class="btn btn-danger btn-block" onclick="if(confirm('Are you sure?')) { /* Delete action */ }">
                    <i class="fa fa-trash"></i> Delete Product
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "active" => "success",
            "inactive" => "secondary",
            "draft" => "info",
            "archived" => "dark",
            _ => "secondary"
        };
    }
}
