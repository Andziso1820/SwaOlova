@{
    ViewData["Title"] = "Deliveries Map";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body" style="height: 600px;">
                <div id="map" style="width: 100%; height: 100%;">
                    <p class="text-muted text-center py-5">
                        <i class="fa fa-map fa-3x"></i>
                        <br />
                        Map integration would display real-time delivery locations here
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Active Deliveries</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    No active deliveries at the moment.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Map integration (Google Maps, Leaflet, etc.) would go here -->
}
