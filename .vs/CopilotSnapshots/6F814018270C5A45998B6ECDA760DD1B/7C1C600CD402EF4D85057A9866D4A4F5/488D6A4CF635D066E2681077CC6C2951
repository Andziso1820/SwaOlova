/* ============================================================
   SWA OLOVA Deliveries Portal
   Bootstrap Theme
============================================================ */

/* ============================================================
   Colour Palette
============================================================ */

:root {
    --h-purple: #007F7F;
    --h-purple-80: #0099A1;
    --h-purple-60: #00B8C4;
    --h-orange: #E64E00;
    --h-orange-80: #EB7133;
    --h-teal: #0099A1;
    --h-teal-80: #00B8C4;
    --h-gold: #66BB6A;
    --h-grey-1: #ADADAD;
    --h-grey-2: #DADADA;
    --h-grey-3: #E9E9E9;
    --h-grey-4: #F4F4F4;
    --body-bg: #F4F4F4;
    --surface-bg: #FFFFFF;
    --text-primary: #007F7F;
    --text-secondary: #6E6E6E;
    --sidebar-bg: #007F7F;
    --sidebar-active: #005F66;
    --sidebar-selected: #0099A1;
}

/* ============================================================
   Base Layout
============================================================ */

html {
    font-size: 14px;
    position: relative;
    min-height: 100%;
}

@media (min-width: 768px) {
    html {
        font-size: 16px;
    }
}

body {
    background-color: var(--body-bg);
    color: var(--text-secondary);
    font-family: Calibri, Arial, sans-serif;
    margin-bottom: 60px;
}

/* ============================================================
   Typography
============================================================ */

h1,
h2,
h3,
h4,
h5,
h6 {
    color: var(--text-primary);
    font-weight: 700;
    margin-bottom: 1rem;
}

.page-title {
    color: var(--h-purple);
    font-size: 2rem;
    font-weight: 700;
}

.text-muted {
    color: var(--h-grey-1) !important;
}

a {
    color: var(--h-teal);
    text-decoration: none;
}

    a:hover {
        color: #006B73;
    }

/* ============================================================
   Bootstrap Focus States
============================================================ */

.btn:focus,
.btn:active:focus,
.btn-link.nav-link:focus,
.form-control:focus,
.form-select:focus,
.form-check-input:focus {
    box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem rgba(68, 180, 166, .35);
}

/* ============================================================
   Navigation Bar
============================================================ */

.navbar {
    background: white;
    border-bottom: 1px solid var(--h-grey-3);
}

.navbar-brand {
    color: var(--h-purple);
    font-weight: 700;
}

.nav-link {
    color: var(--text-secondary);
}

/* ============================================================
   Sidebar
============================================================ */

.navbar-default {
    background: var(--sidebar-bg);
}

    .navbar-default.navbar-static-side {
        background: var(--sidebar-bg);
    }

.sidebar-collapse {
    background: var(--sidebar-bg);
}

.nav-header {
    background: var(--sidebar-bg);
    padding: 25px;
}

.app-logo {
    display: block;
    max-width: 130px;
    height: auto;
    margin-bottom: 14px;
}

.app-title {
    display: block;
    color: white;
    font-size: 20px;
    font-weight: 700;
}

.app-subtitle {
    color: rgba(255,255,255,.75);
}

.menu-arrow {
    font-size: 12px;
}

#side-menu {
    background: var(--sidebar-bg);
}

    #side-menu > li > a {
        color: #A7B1C2;
        padding: 14px 20px;
        font-weight: 500;
        width: 100%;
        box-sizing: border-box;
    }

        #side-menu > li > a:hover {
            background: var(--sidebar-active);
            color: white;
        }

    #side-menu > li.active > a {
        border-left: 4px solid var(--h-teal);
        background: var(--sidebar-selected);
        color: white;
    }

    #side-menu .nav-second-level {
        background: var(--sidebar-active);
    }

    #side-menu li.has-submenu > .nav-second-level {
        display: none;
    }

    #side-menu li.has-submenu.menu-expanded > .nav-second-level {
        display: block;
    }

    #side-menu li.has-submenu > a .menu-arrow {
        transition: transform .2s ease;
    }

    #side-menu li.has-submenu > a[aria-expanded="true"] .menu-arrow {
        transform: rotate(180deg);
    }

    #side-menu li.active .nav-second-level li a {
        background: transparent;
        border-left-color: transparent;
        color: #A7B1C2;
    }

.nav-second-level li a {
    display: block;
    width: 100%;
    box-sizing: border-box;
    color: #A7B1C2;
    padding: 10px 10px 10px 52px;
}

#side-menu .nav-second-level li a:hover,
#side-menu .nav-second-level li.active a {
    color: white;
    background: var(--sidebar-selected);
    border-left-color: var(--h-teal);
}

.metismenu li {
    position: relative;
}

#side-menu > li {
    width: 100%;
}

    #side-menu > li > a {
        width: 100%;
        box-sizing: border-box;
    }
/* ============================================================
   Cards
============================================================ */

.card,
.ibox-content {
    background: var(--surface-bg);
    border: 1px solid var(--h-grey-3);
    border-radius: 8px;
}

.card-header {
    background: white;
    color: var(--h-purple);
    border-bottom: 1px solid var(--h-grey-3);
    font-weight: 600;
}

/* ============================================================
   Forms
============================================================ */

.form-label {
    color: var(--text-secondary);
    font-weight: 600;
}

.form-control,
.form-select {
    border: 2px solid var(--h-grey-2);
    border-radius: 4px;
    min-height: 46px;
    box-shadow: none;
}

    .form-control:focus,
    .form-select:focus {
        border-color: var(--h-teal);
    }

textarea.form-control {
    min-height: 120px;
}

/* ============================================================
   Buttons
============================================================ */

.btn {
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
}

/* SWA OLOVA Teal */

.btn-primary {
    background-color: var(--h-purple);
    border-color: var(--h-purple);
}

    .btn-primary:hover {
        background-color: var(--h-purple-80);
        border-color: var(--h-purple-80);
    }

/* Orange CTA */

.btn-orange {
    color: white;
    background: var(--h-orange);
    border-color: var(--h-orange);
}

    .btn-orange:hover {
        color: white;
        background: var(--h-orange-80);
        border-color: var(--h-orange-80);
    }

/* Teal Action */

.btn-teal {
    color: white;
    background: var(--h-teal);
    border-color: var(--h-teal);
}

    .btn-teal:hover {
        color: white;
        background: var(--h-teal-80);
    }

/* Outline Teal */

.btn-outline-teal {
    color: var(--h-teal);
    border: 2px solid var(--h-teal);
    background: white;
}

    .btn-outline-teal:hover {
        background: var(--h-teal);
        color: white;
    }

/* ============================================================
   Tables
============================================================ */

.table {
    background: white;
}

    .table thead th {
        color: var(--h-purple);
        font-weight: 600;
        border-bottom: 2px solid var(--h-grey-2);
    }

.table-hover tbody tr:hover {
    background: #fafafa;
}

/* ============================================================
   Dashboard Cards
============================================================ */

.metric-card {
    background: white;
    border: 1px solid var(--h-grey-3);
    border-radius: 8px;
    padding: 20px;
}

.metric-value {
    color: var(--h-purple);
    font-weight: 700;
    font-size: 2rem;
}

.metric-title {
    color: var(--h-grey-1);
    text-transform: uppercase;
    font-size: .85rem;
}

/* ============================================================
   Campaign Statuses
============================================================ */

.badge-draft {
    background: var(--h-grey-1);
    color: white;
}

.badge-scheduled {
    background: var(--h-gold);
    color: white;
}

.badge-running {
    background: var(--h-teal);
    color: white;
}

.badge-completed {
    background: var(--h-purple);
    color: white;
}

.badge-failed {
    background: var(--h-orange);
    color: white;
}

/* ============================================================
   Wizard Stepper
============================================================ */

.step {
    display: inline-block;
    width: 35px;
    height: 35px;
    line-height: 35px;
    text-align: center;
    border-radius: 50%;
    background: var(--h-grey-3);
    color: var(--text-secondary);
}

    .step.active {
        background: var(--h-purple);
        color: white;
    }

    .step.complete {
        background: var(--h-teal);
        color: white;
    }

/* ============================================================
   Alerts
============================================================ */

.alert-success {
    border-left: 4px solid var(--h-teal);
}

.alert-warning {
    border-left: 4px solid var(--h-gold);
}

.alert-danger {
    border-left: 4px solid var(--h-orange);
}

/* ============================================================
   Footer
============================================================ */

.footer {
    background: white;
    border-top: 1px solid var(--h-grey-3);
    color: var(--h-grey-1);
    padding: 15px;
}

/* ============================================================
   Utilities
============================================================ */

.bg-purple {
    background: var(--h-purple);
}

.bg-orange {
    background: var(--h-orange);
}

.bg-teal {
    background: var(--h-teal);
}

.text-purple {
    color: var(--h-purple);
}

.text-orange {
    color: var(--h-orange);
}

.text-teal {
    color: var(--h-teal);
}

.template-link-action {
    color: #0099A1;
}

    .template-link-action:hover,
    .template-link-action:focus {
        color: #006B73;
    }

.template-delete-action {
    color: var(--h-orange);
}

    .template-delete-action:hover,
    .template-delete-action:focus {
        color: var(--h-orange-80);
    }

/* ============================================================
   Template Details
============================================================ */

.template-details-page .card-header {
    font-weight: 700;
}

.template-action-bar {
    gap: 0.5rem;
}

.template-info-list dt {
    color: var(--h-purple);
    font-weight: 700;
}

.template-preview {
    background: var(--h-grey-4);
    border: 1px solid var(--h-grey-2);
    border-radius: 6px;
    padding: 10px;
    white-space: pre-wrap;
    word-break: break-word;
}

/* ============================================================
   Campaign Workspace
============================================================ */

.campaign-view-tabs .nav-link {
    color: var(--h-purple);
    font-weight: 600;
}

    .campaign-view-tabs .nav-link.active {
        background: var(--h-purple);
        color: #fff;
    }

.campaign-action-bar .form-control {
    min-width: 220px;
}

.campaign-details-page .campaign-action-bar .btn {
    border-color: var(--h-grey-2);
    background: var(--h-grey-3);
    color: #8B8B8B;
}

    .campaign-details-page .campaign-action-bar .btn:disabled,
    .campaign-details-page .campaign-action-bar .btn.disabled {
        border-color: var(--h-grey-2);
        background: var(--h-grey-3);
        color: #8B8B8B;
        opacity: 1;
    }

    .campaign-details-page .campaign-action-bar .btn:not(:disabled):not(.disabled) {
        border-color: var(--h-purple);
        background: var(--h-purple);
        color: #fff;
    }

        .campaign-details-page .campaign-action-bar .btn:not(:disabled):not(.disabled):hover,
        .campaign-details-page .campaign-action-bar .btn:not(:disabled):not(.disabled):focus {
            border-color: var(--h-purple-80);
            background: var(--h-purple-80);
            color: #fff;
        }

.campaign-details-page .card-header,
.campaign-workspace-page .card-header {
    font-weight: 700;
}

.campaign-create-form-card {
    border-color: var(--h-grey-2);
}

.campaign-create-guide {
    background: linear-gradient(180deg, #f8f5fb 0%, #ffffff 100%);
    border: 1px solid #e8e0ef;
    border-radius: 8px;
}

.campaign-create-guide-header h5 {
    color: var(--h-purple);
    font-weight: 700;
}

.campaign-create-guide-header p {
    color: #6f5f7b;
    font-size: 0.92rem;
}

.campaign-create-guide-logo {
    display: block;
    margin-bottom: 0.75rem;
    max-width: 150px;
}

.campaign-create-guide-item {
    align-items: flex-start;
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
}

    .campaign-create-guide-item i {
        color: var(--h-orange);
        font-size: 1.15rem;
        line-height: 1.25;
        margin-top: 0.1rem;
        width: 18px;
    }

    .campaign-create-guide-item strong {
        color: var(--h-purple);
        display: block;
        font-weight: 700;
        margin-bottom: 0.1rem;
    }

    .campaign-create-guide-item span {
        color: #5f5f5f;
        display: block;
        font-size: 0.9rem;
        line-height: 1.35;
    }

.campaign-create-guide-note {
    align-items: center;
    background: #ece4f3;
    border-left: 4px solid var(--h-purple);
    color: var(--h-purple);
    display: flex;
    font-size: 0.88rem;
    font-weight: 600;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
}

    .campaign-create-guide-note i {
        color: var(--h-teal);
        font-size: 1rem;
    }

.phone-preview-frame {
    max-width: 320px;
    margin: 0 auto;
    padding: 10px;
    border: 8px solid #1f1f1f;
    border-radius: 28px;
    background: #1f1f1f;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
}

.phone-preview-notch {
    width: 110px;
    height: 12px;
    border-radius: 0 0 10px 10px;
    margin: -10px auto 10px;
    background: #0f0f0f;
}

.phone-preview-screen {
    background: #e5ddd5;
    border-radius: 18px;
    min-height: 330px;
    overflow: hidden;
}

.phone-preview-header {
    background: #075e54;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 10px 12px;
}

.template-preview-phone {
    background: #dcf8c6;
    border: 0;
    border-radius: 14px;
    margin: 12px;
    max-height: 275px;
    overflow-y: auto;
}

body.campaign-loading {
    overflow: hidden;
}

.campaign-loading-overlay {
    align-items: center;
    background: rgba(34, 22, 46, 0.35);
    display: none;
    inset: 0;
    justify-content: center;
    position: fixed;
    z-index: 2000;
}

    .campaign-loading-overlay.active {
        display: flex;
    }

.campaign-loading-content {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.campaign-loading-text {
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
}

.hollard-loader {
    animation: hollard-spin 1s linear infinite;
    background: conic-gradient(from 180deg, var(--h-purple), var(--h-orange), var(--h-teal), var(--h-gold), var(--h-purple));
    border-radius: 50%;
    box-shadow: 0 12px 28px rgba(68, 35, 89, 0.35);
    height: 84px;
    position: relative;
    width: 84px;
}

    .hollard-loader::before {
        background: #fff;
        border-radius: 50%;
        content: "";
        inset: 11px;
        position: absolute;
    }

    .hollard-loader::after {
        animation: hollard-pulse 0.9s ease-in-out infinite alternate;
        background: var(--h-purple);
        border-radius: 50%;
        content: "";
        inset: 29px;
        position: absolute;
    }

@keyframes hollard-spin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes hollard-pulse {
    from {
        background: var(--h-purple);
    }

    to {
        background: var(--h-orange);
    }
}

.campaign-modal-feedback {
    width: 100%;
}

.campaign-submit-feedback {
    align-items: center;
    border: 0;
    border-radius: 0;
    display: flex;
    font-weight: 700;
    min-height: 42px;
    padding: 10px 12px;
    width: 100%;
}

.campaign-submit-feedback-loading {
    background: #f4f4f4;
    color: var(--h-purple);
}

.campaign-submit-feedback-success {
    background: #d7f0ec;
    border-left: 4px solid var(--h-teal);
    color: #0b4f47;
}

    .campaign-submit-feedback-success .fa-check-circle {
        font-size: 1.35rem;
        margin-right: 10px;
    }

.campaign-submit-feedback-error {
    background: #fde8e8;
    border-left: 4px solid #cf1e1e;
    color: #7a1010;
}
