@model SwaOlova.Portal.Areas.Riders.Models.RiderVehicleViewModel

@{
    Layout = null;
}

<form method="post"
      asp-action="SaveVehicle"
      asp-controller="Riders"
      asp-area="Riders"
      asp-route-id="@Model.RiderId"
      data-campaign-modal-form="true">
    <input asp-for="RiderId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="VehicleType" class="form-label"></label>
            <select asp-for="VehicleType" class="form-select" asp-items="@(new SelectList(SwaOlova.Portal.Areas.Riders.Models.RiderVehicleViewModel.VehicleTypes))">
                <option value="">-- Select Vehicle Type --</option>
            </select>
            <span asp-validation-for="VehicleType" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="RegistrationNumber" class="form-label"></label>
            <input asp-for="RegistrationNumber" class="form-control text-uppercase" />
            <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Make" class="form-label"></label>
            <input asp-for="Make" class="form-control" />
            <span asp-validation-for="Make" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Model" class="form-label"></label>
            <input asp-for="Model" class="form-control" />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary btn-sm">
            Save Vehicle
        </button>
    </div>
</form>
