using MediatR;
using SwaOlova.Application.Common.Interfaces.Repositories;
using SwaOlova.Application.Common.Models;
using SwaOlova.Application.Features.Payments.Dtos;

namespace SwaOlova.Application.Features.Payments.Queries.GetPaymentsByOrder;

public sealed class GetPaymentsByOrderQueryHandler(IPaymentRepository paymentRepository)
    : IRequestHandler<GetPaymentsByOrderQuery, Result<GetPaymentsByOrderResponse>>
{
    public async Task<Result<GetPaymentsByOrderResponse>> Handle(GetPaymentsByOrderQuery request, CancellationToken cancellationToken)
    {
        var allPayments = await paymentRepository.SearchAsync(string.Empty, cancellationToken);

        var orderPayments = allPayments
            .Where(p => p.OrderId == request.OrderId)
            .ToList();

        var paymentDtos = orderPayments
            .Select(PaymentDtoMapper.ToDto)
            .ToArray();

        var totalAmount = orderPayments.Sum(p => p.Amount);

        var response = new GetPaymentsByOrderResponse(paymentDtos, totalAmount);
        return Result<GetPaymentsByOrderResponse>.Success(response);
    }
}
