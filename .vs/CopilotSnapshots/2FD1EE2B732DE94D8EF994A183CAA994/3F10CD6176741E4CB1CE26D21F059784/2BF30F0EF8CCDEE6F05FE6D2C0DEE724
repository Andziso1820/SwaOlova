@using SwaOlova.Application.Features.Riders.Queries.GetRiderById
@model GetRiderByIdResponse

@{
    ViewData["Title"] = "Rider Details";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Personal Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>First Name:</strong></p>
                        <p>@Model.Rider.FirstName</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Last Name:</strong></p>
                        <p>@Model.Rider.LastName</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Email:</strong></p>
                        <p>@Model.Rider.Email</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Phone:</strong></p>
                        <p>@Model.Rider.PhoneNumber</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Status:</strong></p>
                        <p><span class="badge bg-@GetStatusColor(Model.Rider.Status.ToString())">@Model.Rider.Status</span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Rating:</strong></p>
                        <p>
                            @for (int i = 0; i < 5; i++)
                            {
                                @if (i < Math.Floor(Model.Rider.Rating ?? 0))
                                {
                                    <i class="fa fa-star text-warning"></i>
                                }
                                else
                                {
                                    <i class="fa fa-star-o text-muted"></i>
                                }
                            }
                            (@Model.Rider.Rating?.ToString("F1"))
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Vehicle Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Vehicle Type:</strong></p>
                        <p>@Model.Rider.VehicleType</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>License Plate:</strong></p>
                        <p>@Model.Rider.LicensePlate</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Vehicle Model:</strong></p>
                        <p>@Model.Rider.VehicleModel</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Insurance Expiry:</strong></p>
                        <p>@Model.Rider.InsuranceExpiryDate?.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Documents</h5>
            </div>
            <div class="card-body">
                <div class="document-list">
                    <div class="document-item mb-2 p-2 border rounded">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-0"><strong>Driver License</strong></p>
                                <p class="text-muted small mb-0">Valid until: -</p>
                            </div>
                            <div>
                                <button type="button" class="btn btn-sm btn-info">
                                    <i class="fa fa-search"></i> View
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="document-item mb-2 p-2 border rounded">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-0"><strong>Vehicle Insurance</strong></p>
                                <p class="text-muted small mb-0">Valid until: -</p>
                            </div>
                            <div>
                                <button type="button" class="btn btn-sm btn-info">
                                    <i class="fa fa-search"></i> View
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Performance</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p class="text-muted small">Total Deliveries</p>
                    <h5>0</h5>
                </div>
                <div class="mb-3">
                    <p class="text-muted small">Completed</p>
                    <h5>0</h5>
                </div>
                <div class="mb-3">
                    <p class="text-muted small">Cancelled</p>
                    <h5>0</h5>
                </div>
                <div>
                    <p class="text-muted small">Success Rate</p>
                    <h5>0%</h5>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Actions</h5>
            </div>
            <div class="card-body">
                @if (Model.Rider.Status.ToString() == "Pending")
                {
                    <form method="post" asp-action="Approve" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Rider.Id" />
                        <button type="submit" class="btn btn-success btn-block mb-2">
                            <i class="fa fa-check"></i> Approve Rider
                        </button>
                    </form>
                }
                @if (Model.Rider.Status.ToString() != "Suspended")
                {
                    <button type="button" class="btn btn-danger btn-block" data-bs-toggle="modal" data-bs-target="#suspendModal">
                        <i class="fa fa-pause"></i> Suspend Rider
                    </button>
                }
                <button type="button" class="btn btn-warning btn-block mt-2">
                    <i class="fa fa-edit"></i> Edit Details
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="suspendModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="Suspend" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Suspend Rider</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
               <input type="hidden" name="id" value="@Model.Rider.Id" />
               <div class="mb-3">
                    <label class="form-label">Reason for Suspension</label>
                    <textarea name="reason" class="form-control" rows="3" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-danger">Suspend Rider</button>
            </div>
        </form>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "approved" => "success",
            "active" => "success",
            "available" => "success",
            "busy" => "info",
            "offline" => "secondary",
            "suspended" => "danger",
            _ => "secondary"
        };
    }
}
