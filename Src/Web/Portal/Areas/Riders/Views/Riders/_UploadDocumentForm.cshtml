@using SwaOlova.Domain.Enums
@model SwaOlova.Portal.Areas.Riders.Models.RiderDocumentUploadViewModel

@{
    Layout = null;
}

<form method="post"
      asp-action="UploadDocument"
      asp-controller="Riders"
      asp-area="Riders"
      asp-route-id="@Model.RiderId"
      enctype="multipart/form-data"
      data-campaign-modal-form="true">
    <input asp-for="RiderId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="DocumentType" class="form-label"></label>
        <select asp-for="DocumentType" class="form-select" asp-items="Html.GetEnumSelectList<RiderDocumentType>().Where(x => x.Value != ((int)RiderDocumentType.None).ToString())">
            <option value="">-- Select Document Type --</option>
        </select>
        <span asp-validation-for="DocumentType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DocumentFile" class="form-label"></label>
        <input asp-for="DocumentFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
        <span asp-validation-for="DocumentFile" class="text-danger"></span>
        <small class="text-muted d-block mt-1">PDF or image, maximum 10 MB.</small>
    </div>

    <div class="mb-3">
        <label asp-for="ExpiryDate" class="form-label"></label>
        <input asp-for="ExpiryDate" type="date" class="form-control" />
        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        <small class="text-muted d-block mt-1">Optional. Leave blank when the document does not expire.</small>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary btn-sm">
            Add Document
        </button>
    </div>
</form>
