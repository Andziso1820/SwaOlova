@model SwaOlova.Portal.Areas.Merchants.Models.MerchantIndexViewModel

@{
    ViewData["Title"] = "Merchants";
}

<div class="merchant-workspace-page">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1 class="mb-0">Merchants</h1>

        <div class="d-flex gap-2">
            <a asp-action="Create" asp-controller="Merchants" asp-area="Merchants" class="btn btn-primary">
                <i class="fa fa-plus"></i>
                Add Merchant
            </a>

            <a asp-action="Export" class="btn btn-outline-secondary">
                <i class="fa fa-download"></i>
                Export
            </a>
        </div>
    </div>

    <ul class="nav nav-pills mb-4">

        <li class="nav-item">
            <a asp-action="Index"
               asp-route-view="dashboard"
               class="nav-link @(Model.ActiveView == "dashboard" ? "active" : "")">
                Dashboard
            </a>
        </li>

        <li class="nav-item">
            <a asp-action="Index"
               asp-route-view="pending"
               class="nav-link @(Model.ActiveView == "pending" ? "active" : "")">
                Pending Approval
            </a>
        </li>

        <li class="nav-item">
            <a asp-action="Index"
               asp-route-view="active"
               class="nav-link @(Model.ActiveView == "active" ? "active" : "")">
                Active
            </a>
        </li>

        <li class="nav-item">
            <a asp-action="Index"
               asp-route-view="suspended"
               class="nav-link @(Model.ActiveView == "suspended" ? "active" : "")">
                Suspended
            </a>
        </li>

        <li class="nav-item">
            <a asp-action="Index"
               asp-route-view="restaurants"
               class="nav-link @(Model.ActiveView == "restaurants" ? "active" : "")">
                Restaurants
            </a>
        </li>

        <li class="nav-item">
            <a asp-action="Index"
               asp-route-view="pharmacies"
               class="nav-link @(Model.ActiveView == "pharmacies" ? "active" : "")">
                Pharmacies
            </a>
        </li>

        <li class="nav-item">
            <a asp-action="Index"
               asp-route-view="shops"
               class="nav-link @(Model.ActiveView == "shops" ? "active" : "")">
                Shops
            </a>
        </li>

    </ul>

    <div class="row g-3 mb-4">

        <div class="col-md-4 col-xl-2">
            <div class="metric-card">
                <div class="metric-value">
                    @(Model.DashboardCounts.TryGetValue("total", out var total) ? total : 0)
                </div>
                <div class="metric-title">
                    Total Merchants
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="metric-card">
                <div class="metric-value">
                    @(Model.DashboardCounts.TryGetValue("pending", out var pending) ? pending : 0)
                </div>
                <div class="metric-title">
                    Pending
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="metric-card">
                <div class="metric-value">
                    @(Model.DashboardCounts.TryGetValue("active", out var active) ? active : 0)
                </div>
                <div class="metric-title">
                    Active
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="metric-card">
                <div class="metric-value">
                    @(Model.DashboardCounts.TryGetValue("suspended", out var suspended) ? suspended : 0)
                </div>
                <div class="metric-title">
                    Suspended
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="metric-card">
                <div class="metric-value">
                    @(Model.DashboardCounts.TryGetValue("restaurants", out var restaurants) ? restaurants : 0)
                </div>
                <div class="metric-title">
                    Restaurants
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="metric-card">
                <div class="metric-value">
                    @(Model.DashboardCounts.TryGetValue("pharmacies", out var pharmacies) ? pharmacies : 0)
                </div>
                <div class="metric-title">
                    Pharmacies
                </div>
            </div>
        </div>

    </div>

    <div class="card mb-4">

        <div class="card-header">
            Search & Filters
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <div class="col-md-4 mb-2">
                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search Merchant..." />
                    </div>

                    <div class="col-md-3 mb-2">
                        <select class="form-select" name="status">
                            <option value="">All Statuses</option>
                            <option>PendingApproval</option>
                            <option>Active</option>
                            <option>Suspended</option>
                        </select>
                    </div>

                    <div class="col-md-3 mb-2">
                        <select class="form-select" name="category">
                            <option value="">All Categories</option>
                            <option>Restaurant</option>
                            <option>Pharmacy</option>
                            <option>Shop</option>
                        </select>
                    </div>

                    <div class="col-md-2 mb-2">
                        <button class="btn btn-primary w-100" type="submit">
                            Search
                        </button>
                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>
                @Model.Heading
            </span>

            <span class="text-muted">
                Total:
                @Model.FilteredMerchants.Count
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-striped table-hover mb-0">

                    <thead>

                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Village</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th style="width:280px;">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.FilteredMerchants.Any())
                        {
                            @foreach (var merchant in Model.FilteredMerchants)
                            {
                                <tr>

                                    <td>
                                        <strong>@merchant.MerchantCode</strong>
                                    </td>

                                    <td>
                                        @merchant.Name
                                    </td>

                                    <td>
                                        @merchant.ContactNumber
                                    </td>

                                    <td>
                                        @(merchant.Address?.Village ?? "N/A")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(merchant.MerchantCategoryName) ? "N/A" : merchant.MerchantCategoryName)
                                    </td>

                                    <td>
                                        <span class="badge @(GetStatusClass(merchant.Status.ToString()))">
                                            @merchant.Status
                                        </span>
                                    </td>

                                    <td>

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@merchant.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Workspace
                                            </a>
                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">

                                    <i class="fa fa-building fa-3x text-muted mb-3"></i>

                                    <div class="text-muted">
                                        No merchants found.
                                    </div>

                                </td>
                            </tr>
                        }


                    @functions
                    {
                        private string GetStatusClass(string status)
                        {
                            return status?.ToLower() switch
                            {
                                "active" => "bg-success",
                                "approved" => "bg-success",
                                "pendingapproval" => "bg-warning",
                                "pending" => "bg-warning",
                                "suspended" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>