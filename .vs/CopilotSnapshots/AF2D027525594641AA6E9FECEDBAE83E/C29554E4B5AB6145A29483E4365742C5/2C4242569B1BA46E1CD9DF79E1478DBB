@using SwaOlova.Application.Features.Products.Dtos
@using SwaOlova.Domain.Enums
@model ProductDto

@{
    ViewData["Title"] = "Product Details";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Product Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Product Name:</strong></p>
                        <p>@Model.Name</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Status:</strong></p>
                        <p><span class="badge bg-info">@Model.Status</span></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12">
                        <p><strong>Description:</strong></p>
                        <p>@Model.Description</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Price:</strong></p>
                        <p>@Model.Price.ToString("C")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Preparation Time:</strong></p>
                        <p>@Model.PreparationTimeMinutes minutes</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12">
                        <p><strong>Inventory:</strong></p>
                        @if (Model.Inventory != null)
                        {
                            <p>
                                Quantity Available: <strong>@Model.Inventory.QuantityAvailable</strong><br/>
                                In Stock: <span class="badge bg-@(Model.Inventory.InStock ? "success" : "danger")">@(Model.Inventory.InStock ? "Yes" : "No")</span>
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">No inventory information available</p>
                        }
                    </div>
                </div>
                @if (Model.Images?.Count > 0)
                {
                    <div class="row">
                        <div class="col-md-12">
                            <p><strong>Images:</strong></p>
                            <div class="row">
                                @foreach (var image in Model.Images.Take(3))
                                {
                                    <div class="col-md-4">
                                        <img src="@image.ImageUrl" class="img-fluid" alt="Product Image" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Actions</h5>
            </div>
            <div class="card-body">
                @if (Model.Status == ProductStatus.Active)
                {
                    <form method="post" asp-action="MarkOutOfStock" class="d-block">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-block mb-2">
                            <i class="fa fa-exclamation"></i> Mark Out of Stock
                        </button>
                    </form>
                }
                <button type="button" class="btn btn-warning btn-block">
                    <i class="fa fa-edit"></i> Edit Product
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Product Info</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p class="text-muted small">Product ID</p>
                    <h6>@Model.Id</h6>
                </div>
                <div>
                    <p class="text-muted small">Merchant ID</p>
                    <h6>@Model.MerchantId</h6>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "active" => "success",
            "inactive" => "secondary",
            "draft" => "info",
            "archived" => "dark",
            _ => "secondary"
        };
    }
}
