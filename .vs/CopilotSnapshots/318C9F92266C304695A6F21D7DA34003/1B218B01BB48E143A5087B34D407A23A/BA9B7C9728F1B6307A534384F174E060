@using SwaOlova.Application.Features.Riders.Queries.SearchRiders
@model SearchRidersResponse

@{
    ViewData["Title"] = "Riders Management";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1>@ViewData["Title"]</h1>
            <a href="#" class="btn btn-primary"><i class="fa fa-plus"></i> Add Rider</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Total Riders</p>
                <h4>@Model?.Items?.Count() ?? 0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Available Now</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Busy</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Offline</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <form class="form-inline" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search riders...">
                        <button type="submit" class="btn btn-info"><i class="fa fa-search"></i></button>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Rating</th>
                            <th>Deliveries</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items?.Any() == true)
                        {
                            @foreach (var rider in Model.Items)
                            {
                                <tr>
                                    <td><strong>@rider.FirstName @rider.LastName</strong></td>
                                    <td>@rider.PhoneNumber</td>
                                    <td>@rider.VehicleType - @rider.LicensePlate</td>
                                    <td>
                                        <span class="badge bg-@GetStatusColor(rider.Status)">@rider.Status</span>
                                    </td>
                                    <td>
                                        <div class="rating">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                @if (i < Math.Floor(rider.Rating ?? 0))
                                                {
                                                    <i class="fa fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-star-o text-muted"></i>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td><span class="badge bg-secondary">0</span></td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = rider.Id })" 
                                           class="btn btn-sm btn-info" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <p class="text-muted">No riders found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "approved" => "success",
            "active" => "success",
            "available" => "success",
            "busy" => "info",
            "offline" => "secondary",
            "suspended" => "danger",
            _ => "secondary"
        };
    }
}
