@model SwaOlova.Portal.Areas.Merchants.Models.MerchantWorkspaceViewModel

@{
    ViewData["Title"] = "Merchant Details";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">
        Merchant Workspace
    </h1>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back To Merchants
    </a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.MerchantActionMessage))
{
    <div class="alert alert-success">
        @Model.MerchantActionMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.MerchantErrorMessage))
{
    <div class="alert alert-danger">
        @Model.MerchantErrorMessage
    </div>
}

<div class="card mb-3">

    <div class="card-header">

        Merchant Actions

    </div>

    <div class="card-body d-flex flex-wrap align-items-center gap-2 campaign-action-bar">
        <button type="button"
                class="btn btn-teal btn-sm js-campaign-modal-link"
                data-campaign-modal-url="@Url.Action("EditForm", "Merchants", new { id = Model.Merchant.Id })"
                data-campaign-modal-title="Edit Merchant"
                data-campaign-modal-size="modal-lg"
                disabled="@(!Model.CanEditMerchant)">
            <i class="fa fa-pencil me-1"></i>
            Edit Merchant
        </button>

        <button type="button"
                class="btn btn-success btn-sm js-campaign-modal-link"
                data-campaign-modal-url="@Url.Action("ApproveForm", "Merchants", new { id = Model.Merchant.Id })"
                data-campaign-modal-title="Approve Merchant"
                data-campaign-modal-size="modal-lg"
                disabled="@(!Model.CanApproveMerchant)">
            <i class="fa fa-thumbs-up me-1"></i>
            Approve Merchant
        </button>

        <button type="button"
                class="btn btn-primary btn-sm js-campaign-modal-link"
                data-campaign-modal-url="@Url.Action("ActivateForm", "Merchants", new { id = Model.Merchant.Id })"
                data-campaign-modal-title="Activate Merchant"
                data-campaign-modal-size="modal-lg"
                disabled="@(!Model.CanActivateMerchant)">
            <i class="fa fa-play-circle me-1"></i>
            Activate Merchant
        </button>

        <button type="button"
                class="btn btn-orange btn-sm js-campaign-modal-link"
                data-campaign-modal-url="@Url.Action("SuspendForm", "Merchants", new { id = Model.Merchant.Id })"
                data-campaign-modal-title="Suspend Merchant"
                data-campaign-modal-size="modal-lg"
                disabled="@(!Model.CanSuspendMerchant)">
            <i class="fa fa-thumbs-down me-1"></i>
            Suspend Merchant
        </button>

        <button type="button"
                class="btn btn-danger btn-sm js-campaign-modal-link"
                data-campaign-modal-url="@Url.Action("CloseMerchantForm", "Merchants", new { id = Model.Merchant.Id })"
                data-campaign-modal-title="Close Merchant"
                data-campaign-modal-size="modal-lg"
                disabled="@(!Model.CanCloseMerchant)">
            <i class="fa fa-times-circle me-1"></i>
            Close Merchant
        </button>
    </div>

</div>

<div class="row g-3">

    <!-- LEFT PANEL -->
    <div class="col-lg-8">

        <div class="card h-100">
            <div class="card-header">
                Merchant Details
            </div>

            <div class="card-body">

                <dl class="row mb-0 template-info-list">

                    <dt class="col-sm-4">Merchant Code</dt>
                    <dd class="col-sm-8">@Model.Merchant.MerchantCode</dd>

                    <dt class="col-sm-4">Merchant Name</dt>
                    <dd class="col-sm-8">@Model.Merchant.Name</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Merchant.MerchantCategoryName) ? "N/A" : Model.Merchant.MerchantCategoryName)</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Merchant.Status</dd>

                    <dt class="col-sm-4">Contact Number</dt>
                    <dd class="col-sm-8">@Model.Merchant.ContactNumber</dd>

                    <dt class="col-sm-4">Village</dt>
                    <dd class="col-sm-8">@Model.Merchant.Address?.Village</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Merchant.Address?.AddressLine1</dd>

                    <dt class="col-sm-4">Latitude</dt>
                    <dd class="col-sm-8">@Model.Merchant.Address?.Latitude</dd>

                    <dt class="col-sm-4">Longitude</dt>
                    <dd class="col-sm-8">@Model.Merchant.Address?.Longitude</dd>

                </dl>

            </div>

        </div>

    </div>

    <!-- RIGHT PANEL -->
    <div class="col-lg-4">

        <!-- DOCUMENTS -->
        <div class="card mb-3">

            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <span>Compliance Documents</span>

                <button type="button"
                        class="btn btn-primary btn-sm js-campaign-modal-link"
                        data-campaign-modal-url="@Url.Action("UploadDocumentForm", "Merchants", new { id = Model.Merchant.Id })"
                        data-campaign-modal-title="Add Compliance Document"
                        data-campaign-modal-size="modal-lg"
                        disabled="@(!Model.CanManageDocuments)">
                    <i class="fa fa-upload me-1"></i>
                    Add Document
                </button>
            </div>

            <div class="card-body">

                @if (Model.HasOutstandingDocuments)
                {
                    <div class="alert alert-warning py-2 small">
                        Review required. One or more compliance documents are missing or expired.
                    </div>
                }

                @if (!Model.Documents.Any())
                {
                    <p class="text-muted small mb-0">
                        No documents uploaded.
                    </p>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-sm align-middle">

                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Status</th>
                                    <th>Expiry</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var document in Model.Documents)
                                {
                                    <tr>

                                        <td>
                                            <div class="fw-semibold">@document.Name</div>
                                            <div class="small text-muted">Uploaded @document.UploadedAt.ToString("dd MMM yyyy")</div>
                                        </td>

                                        <td>
                                            <span class="badge @document.StatusBadgeClass">@document.Status</span>
                                        </td>

                                        <td>@(document.ExpiryDate?.ToString("dd MMM yyyy") ?? "No expiry")</td>

                                        <td>
                                            <a href="@document.FileUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-link btn-sm px-0">
                                                <i class="fa fa-external-link me-1"></i>
                                                Open
                                            </a>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <!-- ACTIVITY -->
        <div class="card">

            <div class="card-header">
                Recent Activity
            </div>

            <div class="card-body">

                @if (!Model.RecentActivities.Any())
                {
                    <p class="text-muted small mb-0">
                        No recent activity recorded.
                    </p>
                }
                else
                {
                    @foreach (var activity in Model.RecentActivities.Take(10))
                    {
                        <div class="border-bottom pb-2 mb-2">

                            <div class="small text-muted">
                                @activity.Date.ToString("dd MMM yyyy HH:mm")
                            </div>

                            <div class="fw-semibold">
                                @activity.Title
                            </div>

                            @if (!string.IsNullOrWhiteSpace(activity.Description))
                            {
                                <div class="small text-muted">
                                    @activity.Description
                                </div>
                            }

                        </div>
                    }
                }

            </div>

        </div>

    </div>

</div>