@using SwaOlova.Portal.Areas.Merchants.Models
@model SuspendMerchantViewModel

@{
    Layout = null;
}

<form asp-action="SuspendForm"
      asp-controller="Merchants"
      asp-area="Merchants"
      method="post"
    asp-route-id="@Model.Id"
    data-campaign-modal-form="true"
    id="suspendMerchantForm">

    <input asp-for="Id" type="hidden" />

    <div class="card merchant-guide-card">

        <div class="card-body">

            <div class="merchant-guide-header d-flex align-items-center mb-3">

                <div class="guide-icon-circle bg-danger-subtle me-3">

                    <i class="fa fa-ban fa-lg text-danger"></i>

                </div>

                <div>

                    <h5 class="mb-1">
                        Merchant Suspension
                    </h5>

                    <p class="text-muted mb-0">
                        Review the impact before suspending this merchant.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-danger">

                <div class="tip-icon">
                    <i class="fa fa-warning"></i>
                </div>

                <div>

                    <strong>
                        Merchant Access Will Be Restricted
                    </strong>

                    <p class="mb-0">

                        Suspending

                        <strong>
                            @Model.MerchantName
                        </strong>

                        will prevent the merchant from trading on
                        Swa Olava.

                    </p>

                </div>

            </div>

            <div class="tip-card tip-warning">

                <div class="tip-icon">
                    <i class="fa fa-shopping-cart"></i>
                </div>

                <div>

                    <strong>
                        Trading Will Stop
                    </strong>

                    <p class="mb-0">

                        Customers will no longer be able to place
                        new orders with this merchant.

                    </p>

                </div>

            </div>

            <div class="tip-card tip-info">

                <div class="tip-icon">
                    <i class="fa fa-users"></i>
                </div>

                <div>

                    <strong>
                        Merchant Users
                    </strong>

                    <p class="mb-0">

                        Merchant administrators may lose access
                        to operational functionality.

                    </p>

                </div>

            </div>

            <div class="mt-4">

                <label asp-for="Reason"
                       class="form-label fw-bold">

                    Suspension Reason

                </label>

                <textarea asp-for="Reason"
                          class="form-control"
                          rows="4"
                          placeholder="Enter suspension reason...">
                </textarea>

            </div>

            <div class="form-check mt-4">

                <input class="form-check-input"
                       type="checkbox"
                       id="confirmMerchantSuspension"
                       data-enable-button="#suspendMerchantButton" />

                <label class="form-check-label"
                       for="confirmMerchantSuspension">

                    I understand the impact and wish to suspend
                    this merchant.

                </label>

            </div>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                id="suspendMerchantButton"
                class="btn btn-danger"
                disabled>

            <i class="fa fa-ban"></i>

            Suspend Merchant

        </button>

    </div>

</form>