@using SwaOlova.Application.Features.Merchants.Dtos
@using SwaOlova.Domain.Enums
@model MerchantDto

@{
    ViewData["Title"] = "Merchant Details";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Business Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Merchant Code:</strong></p>
                        <p>@Model.MerchantCode</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Status:</strong></p>
                        <p><span class="badge bg-info">@Model.Status</span></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Merchant Name:</strong></p>
                        <p>@Model.Name</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Contact Number:</strong></p>
                        <p>@Model.ContactNumber</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12">
                        <p><strong>Address:</strong></p>
                        <p>@Model.Address?.AddressLine1, @Model.Address?.Village</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Latitude:</strong></p>
                        <p>@Model.Address?.Latitude</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Longitude:</strong></p>
                        <p>@Model.Address?.Longitude</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Products</h5>
            </div>
            <div class="card-body">
                @if (Model.Products?.Count > 0)
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Prep Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.Name</td>
                                    <td>@product.Price.ToString("C")</td>
                                    <td>@product.PreparationTimeMinutes mins</td>
                                    <td><span class="badge bg-secondary">@product.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No products available</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Actions</h5>
            </div>
            <div class="card-body">
                @if (Model.Status == MerchantStatus.Pending)
                {
                    <form method="post" asp-action="Approve" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success btn-block mb-2">
                            <i class="fa fa-check"></i> Approve Merchant
                        </button>
                    </form>
                }
                @if (Model.Status != MerchantStatus.Suspended && Model.Status != MerchantStatus.Inactive)
                {
                    <button type="button" class="btn btn-danger btn-block" data-bs-toggle="modal" data-bs-target="#suspendModal">
                        <i class="fa fa-pause"></i> Suspend Merchant
                    </button>
                }
                <button type="button" class="btn btn-warning btn-block mt-2">
                    <i class="fa fa-edit"></i> Edit Details
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Info</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p class="text-muted small">Total Products</p>
                    <h5>@(Model.Products?.Count ?? 0)</h5>
                </div>
                <div>
                    <p class="text-muted small">Merchant ID</p>
                    <h6>@Model.Id</h6>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="suspendModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="Suspend" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Suspend Merchant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Reason for Suspension</label>
                    <textarea name="reason" class="form-control" rows="3" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-danger">Suspend</button>
            </div>
        </form>
    </div>
</div>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-danger">Suspend Merchant</button>
            </div>
        </form>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "approved" => "success",
            "active" => "success",
            "suspended" => "danger",
            "inactive" => "secondary",
            _ => "secondary"
        };
    }
}
