@using SwaOlova.Portal.Areas.Merchants.Models
@model ApproveMerchantViewModel

@{
    Layout = null;
}

<form asp-action="ApproveForm"
      asp-controller="Merchants"
      asp-area="Merchants"
      method="post"
      asp-route-id="@Model.Id"
      data-campaign-modal-form="true"
      id="approveMerchantForm">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>


    <input asp-for="Id" type="hidden" />

    <div class="card merchant-guide-card h-100">
        <div class="card-body">

            <div class="merchant-guide-header d-flex align-items-center mb-3">

                <div class="guide-icon-circle bg-primary-subtle me-3">
                    <i class="fa fa-store fa-lg text-primary"></i>
                </div>

                <div>
                    <h5 class="mb-1">
                        Merchant Onboarding Guide
                    </h5>

                    <p class="text-muted mb-0">
                        Follow these steps to prepare merchants for trading.
                    </p>
                </div>

            </div>

            <div class="tip-card tip-success">

                <div class="tip-icon">
                    <i class="fa fa-building"></i>
                </div>

                <div>
                    <strong>Business Details</strong>
                    <p class="mb-0">
                        Confirm the trading name and contact information
                        are accurate before creating the merchant.
                    </p>
                </div>

            </div>

            <div class="tip-card tip-info">

                <div class="tip-icon">
                    <i class="fa fa-map-marker"></i>
                </div>

                <div>
                    <strong>Location Matters</strong>
                    <p class="mb-0">
                        GPS coordinates improve delivery accuracy and
                        rider navigation.
                    </p>
                </div>

            </div>

            <div class="tip-card tip-warning">

                <div class="tip-icon">
                    <i class="fa fa-tags"></i>
                </div>

                <div>
                    <strong>Configure Products</strong>
                    <p class="mb-0">
                        After creating the merchant, add products,
                        categories and pricing.
                    </p>
                </div>

            </div>

            <div class="tip-card tip-purple">

                <div class="tip-icon">
                    <i class="fa fa-clock-o"></i>
                </div>

                <div>
                    <strong>Trading Hours</strong>
                    <p class="mb-0">
                        Capture operating hours so customers know when
                        orders can be placed.
                    </p>
                </div>

            </div>

            <div class="tip-card tip-danger">

                    <input class="form-check-input"
                           type="checkbox"
                       data-enable-button="#approveMerchantButton"
                           id="confirmMerchantApproval" />

                    <label class="form-check-label" data-enable-button="#approveMerchantButton"
                           for="confirmMerchantApproval">

                        I have reviewed the merchant information and confirm
                        that this merchant is ready to begin trading on
                        Swa Olava.

                    </label>

            </div>

        </div>
    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                id="approveMerchantButton"
                class="btn btn-success"

                disabled>

            <i class="fa fa-check-circle"></i>

            Approve Merchant

        </button>

    </div>


</form>
