@using SwaOlova.Portal.Areas.Merchants.Models
@model ActivateMerchantViewModel

@{
    Layout = null;
}

<form asp-action="ActivateForm"
      asp-controller="Merchants"
      asp-area="Merchants"
      method="post"
      asp-route-id="@Model.Id"
      data-campaign-modal-form="true"
      id="activateMerchantForm">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="card merchant-guide-card">

        <div class="card-body">

            <div class="merchant-guide-header d-flex align-items-center mb-3">

                <div class="guide-icon-circle bg-success-subtle me-3">

                    <i class="fa fa-play-circle fa-lg text-success"></i>

                </div>

                <div>

                    <h5 class="mb-1">
                        Merchant Reactivation Guide
                    </h5>

                    <p class="text-muted mb-0">
                        Follow these checks before returning the merchant to active trading.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-success">

                <div class="tip-icon">
                    <i class="fa fa-store"></i>
                </div>

                <div>

                    <strong>Ready To Resume Trading</strong>

                    <p class="mb-0">
                        Activating this merchant will make the store available
                        to customers again and allow new orders to be placed.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-info">

                <div class="tip-icon">
                    <i class="fa fa-shopping-cart"></i>
                </div>

                <div>

                    <strong>Orders Will Be Accepted</strong>

                    <p class="mb-0">
                        Once activated, customers will immediately be able
                        to browse products and place orders.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-warning">

                <div class="tip-icon">
                    <i class="fa fa-tags"></i>
                </div>

                <div>

                    <strong>Verify Products & Pricing</strong>

                    <p class="mb-0">
                        Ensure products are available, prices are correct,
                        and out-of-stock items have been updated.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-purple">

                <div class="tip-icon">
                    <i class="fa fa-clock-o"></i>
                </div>

                <div>

                    <strong>Operating Hours</strong>

                    <p class="mb-0">
                        Confirm the merchant's operating hours are configured
                        correctly so customers can place orders at the right times.
                    </p>

                </div>

            </div>

            <div class="mb-4">

                <label asp-for="Reason"
                       class="form-label fw-bold">

                    Activation Notes

                </label>

                <textarea asp-for="Reason"
                          class="form-control"
                          rows="3"
                          placeholder="Reason for reactivating the merchant">
                </textarea>

                <span asp-validation-for="Reason"
                      class="text-danger">
                </span>

            </div>

            <div class="tip-card tip-success">

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           id="confirmMerchantActivation"
                           data-enable-button="#activateMerchantButton" />

                    <label class="form-check-label"
                           for="confirmMerchantActivation">

                        I have verified the merchant information and confirm
                        that this merchant is ready to resume trading on
                        Swa Olava.

                    </label>

                </div>

            </div>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                id="activateMerchantButton"
                class="btn btn-success"
                disabled>

            <i class="fa fa-play-circle"></i>

            Activate Merchant

        </button>

    </div>

</form>