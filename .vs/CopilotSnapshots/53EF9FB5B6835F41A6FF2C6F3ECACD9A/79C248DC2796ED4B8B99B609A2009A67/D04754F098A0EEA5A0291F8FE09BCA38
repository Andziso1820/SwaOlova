using MediatR;
using Microsoft.AspNetCore.Mvc;
using Portal.Models;
using SwaOlova.Application.Features.Products.Queries.GetProductById;
using SwaOlova.Application.Features.Products.Queries.GetProductsPaged;
using SwaOlova.Application.Features.Products.Queries.SearchProducts;
using SwaOlova.Application.Features.Products.Commands.MarkProductOutOfStock;

namespace Portal.Areas.Products.Controllers
{
    [Area("Products")]
    public class ProductsController : Controllers.BaseController
    {
        public ProductsController(IMediator mediator) : base(mediator)
        {
        }

        public async Task<IActionResult> Index(int pageNumber = 1, int pageSize = 10)
        {
            var query = new GetProductsPagedQuery
            {
                PageNumber = pageNumber,
                PageSize = pageSize
            };

            var result = await Mediator.Send(query);
            return View(result);
        }

        public async Task<IActionResult> Details(Guid id)
        {
            var query = new GetProductByIdQuery { ProductId = id };
            var result = await Mediator.Send(query);

            if (result == null)
                return NotFound();

            return View(result);
        }

        public async Task<IActionResult> Search(string searchTerm, int pageNumber = 1, int pageSize = 10)
        {
            var query = new SearchProductsQuery
            {
                Term = searchTerm,
                PageNumber = pageNumber,
                PageSize = pageSize
            };

            var result = await Mediator.Send(query);
            return View("Index", result);
        }

        [HttpPost]
        public async Task<IActionResult> MarkOutOfStock(Guid id)
        {
            var command = new MarkProductOutOfStockCommand { ProductId = id };
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
                TempData["Success"] = "Product marked as out of stock.";
            else
                TempData["Error"] = "Failed to mark product as out of stock.";

            return RedirectToAction(nameof(Details), new { id });
        }
    }
}
