@model SwaOlova.Portal.Areas.Riders.Models.RiderStatusViewModel

@{
    Layout = null;
}

<form method="post"
      asp-action="Suspend"
      asp-controller="Riders"
      asp-area="Riders"
      asp-route-id="@Model.RiderId"
      data-campaign-modal-form="true"
      id="suspendRiderForm">

    <partial name="_StatusFormFields" model="Model" />

    <div class="card merchant-guide-card">
        <div class="card-body">
            <div class="merchant-guide-header d-flex align-items-center mb-3">
                <div class="guide-icon-circle bg-danger-subtle me-3">
                    <i class="fa fa-ban fa-lg text-danger"></i>
                </div>

                <div>
                    <h5 class="mb-1">Rider Suspension</h5>
                    <p class="text-muted mb-0">
                        Review the operational impact before suspending this rider.
                    </p>
                </div>
            </div>

            <div class="tip-card tip-danger">
                <div class="tip-icon">
                    <i class="fa fa-warning"></i>
                </div>

                <div>
                    <strong>Delivery Access Will Be Restricted</strong>
                    <p class="mb-0">
                        Suspending <strong>@Model.RiderName</strong> will prevent the rider from accepting new deliveries on Swa Olava.
                    </p>
                </div>
            </div>

            <div class="tip-card tip-warning">
                <div class="tip-icon">
                    <i class="fa fa-road"></i>
                </div>

                <div>
                    <strong>Availability Will Be Blocked</strong>
                    <p class="mb-0">
                        The rider will be unable to go online or receive fresh dispatch assignments until reactivated.
                    </p>
                </div>
            </div>

            <div class="tip-card tip-info">
                <div class="tip-icon">
                    <i class="fa fa-history"></i>
                </div>

                <div>
                    <strong>Reactivation Remains Available</strong>
                    <p class="mb-0">
                        This action is reversible, but the suspension reason should clearly explain why operations were paused.
                    </p>
                </div>
            </div>

            <div class="mt-4">
                <label asp-for="Reason" class="form-label fw-bold">Suspension Reason</label>
                <textarea asp-for="Reason"
                          class="form-control"
                          rows="4"
                          placeholder="Enter the reason for suspending this rider..."></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="form-check mt-4">
                <input class="form-check-input"
                       type="checkbox"
                       id="confirmRiderSuspension"
                       data-enable-button="#suspendRiderButton" />

                <label class="form-check-label" for="confirmRiderSuspension">
                    I understand the impact and wish to suspend this rider.
                </label>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                id="suspendRiderButton"
                class="btn btn-danger"
                disabled>
            <i class="fa fa-ban"></i>
            Suspend Rider
        </button>
    </div>
</form>
