@using SwaOlova.Portal.Areas.Merchants.Models
@model CloseMerchantViewModel

@{
    Layout = null;
}

<form asp-action="CloseMerchantForm"
      asp-controller="Merchants"
      asp-area="Merchants"
      method="post"
      asp-route-id="@Model.Id">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div class="card merchant-guide-card">

        <div class="card-body">

            <div class="merchant-guide-header d-flex align-items-center mb-3">

                <div class="guide-icon-circle bg-danger-subtle me-3">
                    <i class="fa fa-times-circle fa-lg text-danger"></i>
                </div>

                <div>

                    <h5 class="mb-1">
                        Merchant Closure Guide
                    </h5>

                    <p class="text-muted mb-0">
                        Closing a merchant is intended to be a permanent action.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-danger">

                <div class="tip-icon">
                    <i class="fa fa-ban"></i>
                </div>

                <div>

                    <strong>
                        Trading Will Stop Permanently
                    </strong>

                    <p class="mb-0">
                        Customers will no longer be able to place
                        orders with this merchant.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-warning">

                <div class="tip-icon">
                    <i class="fa fa-shopping-cart"></i>
                </div>

                <div>

                    <strong>
                        Active Orders
                    </strong>

                    <p class="mb-0">
                        Ensure all active orders and disputes
                        have been resolved.
                    </p>

                </div>

            </div>

            <div class="tip-card tip-info">

                <div class="tip-icon">
                    <i class="fa fa-users"></i>
                </div>

                <div>

                    <strong>
                        Merchant Access
                    </strong>

                    <p class="mb-0">
                        Merchant administrators will no longer
                        be able to operate the store.
                    </p>

                </div>

            </div>

            <div class="mb-4">

                <label asp-for="Reason"
                       class="form-label fw-bold">

                    Closure Reason

                </label>

                <textarea asp-for="Reason"
                          rows="4"
                          class="form-control"
                          placeholder="Reason for closing the merchant">
                </textarea>

                <span asp-validation-for="Reason"
                      class="text-danger">
                </span>

            </div>

            <div class="tip-card tip-danger">

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           id="confirmMerchantClosure"
                           data-enable-button="#closeMerchantButton" />

                    <label class="form-check-label"
                           for="confirmMerchantClosure">

                        I understand that closing this merchant
                        will permanently prevent it from trading
                        on Swa Olava.

                    </label>

                </div>

            </div>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                id="closeMerchantButton"
                class="btn btn-danger"
                disabled>

            <i class="fa fa-times-circle"></i>

            Close Merchant

        </button>

    </div>

</form>