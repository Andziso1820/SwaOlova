using SwaOlova.Domain.Order;
using System.Linq;

namespace SwaOlova.Application.Features.Orders.Dtos;

internal static class OrderDtoMapper
{
    public static OrderDto ToDto(Order order)
    {
        return new OrderDto(
            order.Id,
            order.OrderNumber,
            order.CustomerId,
            order.MerchantId,
            order.DeliveryAddressId,
            order.OrderType,
            order.Status,
            order.SubTotal,
            order.DeliveryFee,
            order.Total,
            order.Items
                .Select(item => new OrderItemDto(
                    item.Id,
                    item.OrderId,
                    item.ProductId,
                    item.Quantity,
                    item.UnitPrice,
                    item.TotalPrice))
                .ToArray());
    }
}
