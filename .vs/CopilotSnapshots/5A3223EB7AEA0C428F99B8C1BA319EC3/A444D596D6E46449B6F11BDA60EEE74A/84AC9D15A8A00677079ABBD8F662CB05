using SwaOlova.Domain.Merchant;
using SwaOlova.Domain.Product;

namespace SwaOlova.Application.Features.Merchants.Dtos;

internal static class MerchantDtoMapper
{
    public static MerchantDto ToDto(Merchant merchant)
    {
        var addressDto = new MerchantAddressDto(
            merchant.Address.AddressLine1,
            merchant.Address.Village,
            merchant.Address.Latitude,
            merchant.Address.Longitude);

        var productsDto = merchant.Products
            .Select(p => new ProductSummaryDto(
                p.Id,
                p.Name,
                p.Price,
                p.PreparationTimeMinutes,
                p.Status.ToString()))
            .ToArray();

        var documentsDto = merchant.ComplianceDocuments
            .OrderByDescending(document => document.CreatedDate)
            .Select(document => new MerchantComplianceDocumentDto(
                document.Id,
                document.MerchantId,
                document.Name,
                document.FileUrl,
                document.ExpiryDate,
                document.CreatedDate))
            .ToArray();

        return new MerchantDto(
            merchant.Id,
            merchant.MerchantCode,
            merchant.Name,
            merchant.ContactNumber,
            merchant.Status,
            merchant.MerchantCategoryId,
            merchant.CreatedDate,
            addressDto,
            productsDto,
            documentsDto);
    }
}
