@using SwaOlova.Application.Features.Merchants.Queries.GetMerchantsPaged
@model GetMerchantsPagedResponse

@{
    ViewData["Title"] = "Merchants Management";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1>@ViewData["Title"]</h1>
            <a href="#" class="btn btn-primary"><i class="fa fa-plus"></i> Add Merchant</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Business Name</th>
                            <th>Owner</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Rating</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items?.Any() == true)
                        {
                            @foreach (var merchant in Model.Items)
                            {
                                <tr>
                                    <td><strong>@merchant.BusinessName</strong></td>
                                    <td>@merchant.ContactPerson</td>
                                    <td>@merchant.PhoneNumber</td>
                                    <td>
                                        <span class="badge bg-@GetStatusColor(merchant.Status)">@merchant.Status</span>
                                    </td>
                                    <td>
                                        <div class="rating">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                @if (i < Math.Floor(merchant.Rating ?? 0))
                                                {
                                                    <i class="fa fa-star text-warning"></i>
                                                }
                                                else if (i < merchant.Rating && merchant.Rating % 1 != 0)
                                                {
                                                    <i class="fa fa-star-half-o text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-star-o text-muted"></i>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = merchant.Id })" 
                                           class="btn btn-sm btn-info" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <p class="text-muted">No merchants found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model?.TotalPages > 1)
            {
                <div class="card-footer">
                    <nav>
                        <ul class="pagination mb-0">
                            @if (Model.PageNumber > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = 1 })">First</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageNumber - 1 })">Previous</a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = i })">@i</a>
                                </li>
                            }

                            @if (Model.PageNumber < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageNumber + 1 })">Next</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.TotalPages })">Last</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "approved" => "success",
            "active" => "success",
            "suspended" => "danger",
            "inactive" => "secondary",
            _ => "secondary"
        };
    }
}
