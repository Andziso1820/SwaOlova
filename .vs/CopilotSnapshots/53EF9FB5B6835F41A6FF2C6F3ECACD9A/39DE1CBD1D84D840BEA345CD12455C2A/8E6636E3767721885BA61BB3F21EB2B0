@using SwaOlova.Application.Features.Payments.Queries.GetPaymentById
@model GetPaymentByIdResponse

@{
    ViewData["Title"] = "Payment Details";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Payment Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Transaction ID:</strong></p>
                        <p>@Model.TransactionId</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Status:</strong></p>
                        <p><span class="badge bg-@GetStatusColor(Model.Status)">@Model.Status</span></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Payment Method:</strong></p>
                        <p>@Model.PaymentMethod</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Amount:</strong></p>
                        <p>@Model.Amount.ToString("C")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Order ID:</strong></p>
                        <p>@Model.OrderId</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Reference Number:</strong></p>
                        <p>@Model.ReferenceNumber</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Created:</strong></p>
                        <p>@Model.CreatedDate?.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Processed:</strong></p>
                        <p>@Model.ProcessedDate?.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="card">
                <div class="card-header bg-danger">
                    <h5 class="mb-0 text-white">Error Details</h5>
                </div>
                <div class="card-body">
                    <p>@Model.ErrorMessage</p>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Actions</h5>
            </div>
            <div class="card-body">
                @if (Model.Status == "Pending")
                {
                    <button type="button" class="btn btn-success btn-block mb-2">
                        <i class="fa fa-check"></i> Confirm Payment
                    </button>
                }
                @if (Model.Status == "Completed")
                {
                    <button type="button" class="btn btn-warning btn-block mb-2">
                        <i class="fa fa-undo"></i> Process Refund
                    </button>
                }
                <a href="#" class="btn btn-info btn-block">
                    <i class="fa fa-file"></i> Download Receipt
                </a>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "processing" => "info",
            "completed" => "success",
            "failed" => "danger",
            "refunded" => "secondary",
            "cancelled" => "danger",
            _ => "secondary"
        };
    }
}
