@{
    ViewData["Title"] = "Payments Management";
}

<div class="row mb-3">
    <div class="col-12">
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Total Revenue</p>
                <h4>$0.00</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Pending Payments</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Successful Payments</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Failed Payments</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <form class="form-inline" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search payments...">
                        <button type="submit" class="btn btn-info"><i class="fa fa-search"></i></button>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Transaction ID</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Payment Method</th>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <p class="text-muted">No payments found.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
