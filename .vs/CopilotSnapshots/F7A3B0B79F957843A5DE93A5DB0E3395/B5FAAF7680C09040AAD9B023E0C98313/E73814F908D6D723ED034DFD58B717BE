using MediatR;
using SwaOlova.Application.Common.Interfaces.Repositories;
using SwaOlova.Application.Common.Models;

namespace SwaOlova.Application.Features.Promotions.Commands.ApplyCoupon;

public sealed class ApplyCouponCommandHandler(
    IPromotionRepository promotionRepository,
    IOrderRepository orderRepository)
    : IRequestHandler<ApplyCouponCommand, Result<ApplyCouponResponse>>
{
    public async Task<Result<ApplyCouponResponse>> Handle(ApplyCouponCommand request, CancellationToken cancellationToken)
    {
        // Verify order exists
        var order = await orderRepository.GetByIdAsync(request.Request.OrderId, cancellationToken);
        if (order is null)
        {
            return Result<ApplyCouponResponse>.Failure($"Order with ID '{request.Request.OrderId}' was not found.");
        }

        // Search for coupon by code (assuming SearchAsync can be used)
        var coupons = await promotionRepository.SearchAsync(request.Request.CouponCode.ToUpper(), cancellationToken);
        var coupon = coupons.FirstOrDefault();

        if (coupon is null)
        {
            return Result<ApplyCouponResponse>.Failure($"Coupon with code '{request.Request.CouponCode}' was not found.");
        }

        // Check if coupon has expired
        if (coupon.ExpiryDate < DateTime.UtcNow)
        {
            return Result<ApplyCouponResponse>.Failure("Coupon has expired.");
        }

        // Calculate final amount (in a real scenario, this would apply the discount to order total)
        decimal discountAmount = coupon.DiscountAmount;
        decimal finalAmount = Math.Max(0, 100m - discountAmount); // Placeholder calculation

        var response = new ApplyCouponResponse(
            request.Request.OrderId,
            coupon.Code,
            discountAmount,
            finalAmount);

        return Result<ApplyCouponResponse>.Success(response);
    }
}
