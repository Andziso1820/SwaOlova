@model SwaOlova.Portal.Areas.Riders.Models.RiderAvailabilityViewModel

@{
    Layout = null;
}

<form method="post"
      asp-action="SetAvailability"
      asp-controller="Riders"
      asp-area="Riders"
      asp-route-id="@Model.RiderId"
      data-campaign-modal-form="true">
    <input asp-for="RiderId" type="hidden" />
    <input asp-for="RiderName" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label class="form-label">Availability for @Model.RiderName</label>
        <div class="d-flex align-items-center gap-3 flex-wrap mt-2">
            <div class="form-check form-check-inline mb-0">
                <input asp-for="IsAvailable" class="form-check-input" type="radio" value="true" id="IsAvailableYes" />
                <label class="form-check-label" for="IsAvailableYes">
                    <span class="fw-semibold">Available</span>
                    <div class="text-muted small">Rider can accept new deliveries</div>
                </label>
            </div>
            <div class="form-check form-check-inline mb-0">
                <input asp-for="IsAvailable" class="form-check-input" type="radio" value="false" id="IsAvailableNo" />
                <label class="form-check-label" for="IsAvailableNo">
                    <span class="fw-semibold">Offline</span>
                    <div class="text-muted small">Rider will not receive delivery assignments</div>
                </label>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary btn-sm">
            Update Availability
        </button>
    </div>
</form>
