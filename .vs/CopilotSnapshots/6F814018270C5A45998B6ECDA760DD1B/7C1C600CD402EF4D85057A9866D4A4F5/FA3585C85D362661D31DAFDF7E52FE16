<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SWA OLOVA Deliveries</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/inspinia-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.Admin.styles.css" asp-append-version="true" />
</head>
<body>
    <div id="wrapper">
        <partial name="_SideNavigationMenu" />

        <div id="page-wrapper" class="gray-bg">
            <div class="row border-bottom">
                <nav class="navbar navbar-static-top" role="navigation">
                    <div class="navbar-header">
                        <span class="navbar-brand">@ViewData["Title"]</span>
                    </div>
                </nav>
            </div>

            <div class="wrapper wrapper-content">
                <main role="main" class="container-fluid p-0">
                    @RenderBody()
                </main>
            </div>

            <div class="modal fade" id="campaignAjaxModal" tabindex="-1" aria-labelledby="campaignAjaxModalTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" id="campaignAjaxModalDialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="campaignAjaxModalTitle">Campaign</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="campaignAjaxModalBody"></div>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div>
                    <strong>Copyright</strong> Hollard &copy; @DateTime.UtcNow.Year
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <div id="campaignAjaxLoadingOverlay" class="campaign-loading-overlay" aria-hidden="true">
        <div class="campaign-loading-content" role="status" aria-live="polite" aria-label="Loading">
            <div class="hollard-loader" aria-hidden="true"></div>
            <div class="campaign-loading-text">Loading campaign form...</div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
