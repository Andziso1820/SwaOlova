using SwaOlova.Application.Common.Interfaces.Repositories;
using SwaOlova.Application.Common.Models;
using SwaOlova.Application.Features.Payments.Commands.CreatePayment;
using SwaOlova.Application.Features.Payments.Dtos;
using SwaOlova.Application.Features.Payments.Queries.GetPaymentsByOrder;
using SwaOlova.Application.Features.Payments.Queries.GetPaymentRefunds;
using SwaOlova.Domain.Enums;
using SwaOlova.Domain.Payment;

namespace SwaOlova.Application.Features.Payments.Services;

public sealed class PaymentOrchestrator(
    IPaymentRepository paymentRepository,
    IOrderRepository orderRepository,
    IUnitOfWork unitOfWork)
    : IPaymentOrchestrator
{
    public async Task<Result<PaymentDto>> CreatePaymentAsync(
        CreatePaymentRequest request,
        CancellationToken cancellationToken = default)
    {
        var order = await orderRepository.GetByIdAsync(request.OrderId, cancellationToken);
        if (order is null)
        {
            return Result<PaymentDto>.Failure($"Order with ID '{request.OrderId}' was not found.");
        }

        var payment = new Payment
        {
            Id = Guid.NewGuid(),
            OrderId = request.OrderId,
            Amount = request.Amount,
            PaymentMethod = request.PaymentMethod.Trim(),
            Status = PaymentStatus.Pending,
            ExternalReference = null
        };

        await paymentRepository.AddAsync(payment, cancellationToken);
        await unitOfWork.SaveChangesAsync(cancellationToken);

        var paymentDto = PaymentDtoMapper.ToDto(payment);
        return Result<PaymentDto>.Success(paymentDto);
    }

    public async Task<Result> CapturePaymentAsync(
        Guid paymentId,
        string externalReference,
        CancellationToken cancellationToken = default)
    {
        var payment = await paymentRepository.GetByIdAsync(paymentId, cancellationToken);
        if (payment is null)
        {
            return Result.Failure($"Payment with ID '{paymentId}' was not found.");
        }

        if (payment.Status != PaymentStatus.Pending)
        {
            return Result.Failure($"Only pending payments can be captured. Current status: {payment.Status}");
        }

        payment.ExternalReference = externalReference.Trim();
        payment.Status = PaymentStatus.Authorized;

        await paymentRepository.UpdateAsync(payment, cancellationToken);
        await unitOfWork.SaveChangesAsync(cancellationToken);

        return Result.Success();
    }

    public async Task<Result> RefundPaymentAsync(
        Guid paymentId,
        decimal amount,
        string reason,
        CancellationToken cancellationToken = default)
    {
        var payment = await paymentRepository.GetByIdAsync(paymentId, cancellationToken);
        if (payment is null)
        {
            return Result.Failure($"Payment with ID '{paymentId}' was not found.");
        }

        if (payment.Status is not (PaymentStatus.Paid or PaymentStatus.Authorized))
        {
            return Result.Failure($"Only paid payments can be refunded. Current status: {payment.Status}");
        }

        if (amount > payment.Amount)
        {
            return Result.Failure("Refund amount cannot exceed payment amount.");
        }

        var refund = new Refund
        {
            Id = Guid.NewGuid(),
            PaymentId = paymentId,
            Amount = amount,
            Reason = reason.Trim()
        };

        if (amount == payment.Amount)
        {
            payment.Status = PaymentStatus.Refunded;
        }

        await paymentRepository.UpdateAsync(payment, cancellationToken);
        await unitOfWork.SaveChangesAsync(cancellationToken);

        return Result.Success();
    }

    public async Task<Result> CancelPaymentAsync(
        Guid paymentId,
        CancellationToken cancellationToken = default)
    {
        var payment = await paymentRepository.GetByIdAsync(paymentId, cancellationToken);
        if (payment is null)
        {
            return Result.Failure($"Payment with ID '{paymentId}' was not found.");
        }

        if (payment.Status is PaymentStatus.Paid or PaymentStatus.Refunded or PaymentStatus.Failed or PaymentStatus.Cancelled)
        {
            return Result.Failure($"Cannot cancel payment with status {payment.Status}.");
        }

        payment.Status = PaymentStatus.Cancelled;

        await paymentRepository.UpdateAsync(payment, cancellationToken);
        await unitOfWork.SaveChangesAsync(cancellationToken);

        return Result.Success();
    }

    public async Task<Result> ProcessWebhookAsync(
        string externalReference,
        string status,
        string? failureReason,
        CancellationToken cancellationToken = default)
    {
        var allPayments = await paymentRepository.SearchAsync(string.Empty, cancellationToken);

        var payment = allPayments.FirstOrDefault(p => p.ExternalReference == externalReference);
        if (payment is null)
        {
            return Result.Failure($"Payment with external reference '{externalReference}' was not found.");
        }

        var paymentStatus = status.ToLowerInvariant();

        payment.Status = paymentStatus switch
        {
            "success" => PaymentStatus.Paid,
            "failed" => PaymentStatus.Failed,
            "cancelled" => PaymentStatus.Cancelled,
            _ => payment.Status
        };

        await paymentRepository.UpdateAsync(payment, cancellationToken);
        await unitOfWork.SaveChangesAsync(cancellationToken);

        return Result.Success();
    }

    public async Task<Result<PaymentDto>> GetPaymentAsync(
        Guid paymentId,
        CancellationToken cancellationToken = default)
    {
        var payment = await paymentRepository.GetByIdAsync(paymentId, cancellationToken);
        if (payment is null)
        {
            return Result<PaymentDto>.Failure($"Payment with ID '{paymentId}' was not found.");
        }

        var paymentDto = PaymentDtoMapper.ToDto(payment);
        return Result<PaymentDto>.Success(paymentDto);
    }

    public async Task<Result<GetPaymentsByOrderResponse>> GetPaymentsByOrderAsync(
        Guid orderId,
        CancellationToken cancellationToken = default)
    {
        var allPayments = await paymentRepository.SearchAsync(string.Empty, cancellationToken);

        var orderPayments = allPayments
            .Where(p => p.OrderId == orderId)
            .ToList();

        var paymentDtos = orderPayments
            .Select(PaymentDtoMapper.ToDto)
            .ToArray();

        var totalAmount = orderPayments.Sum(p => p.Amount);

        var response = new GetPaymentsByOrderResponse(paymentDtos, totalAmount);
        return Result<GetPaymentsByOrderResponse>.Success(response);
    }

    public async Task<Result<GetPaymentRefundsResponse>> GetPaymentRefundsAsync(
        Guid paymentId,
        CancellationToken cancellationToken = default)
    {
        var payment = await paymentRepository.GetByIdAsync(paymentId, cancellationToken);
        if (payment is null)
        {
            return Result<GetPaymentRefundsResponse>.Failure($"Payment with ID '{paymentId}' was not found.");
        }

        var refunds = Array.Empty<RefundDto>();
        var totalRefunded = 0m;

        var response = new GetPaymentRefundsResponse(refunds, totalRefunded);
        return Result<GetPaymentRefundsResponse>.Success(response);
    }
}
