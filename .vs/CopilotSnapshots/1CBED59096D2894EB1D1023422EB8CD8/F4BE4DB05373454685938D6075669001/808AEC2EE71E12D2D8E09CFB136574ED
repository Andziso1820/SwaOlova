using Microsoft.AspNetCore.Identity;
using SwaOlova.Domain.Enums;
using SwaOlova.Infrastructure.Data.Identity;

namespace SwaOlova.Infrastructure.Data.Seed;

public sealed class AdminSeeder
{
    private const string AdminEmail = "admin@swaolova.local";
    private const string AdminPassword = "Admin@12345!";

    private readonly UserManager<ApplicationUser> _userManager;
    private readonly RoleManager<ApplicationRole> _roleManager;

    public AdminSeeder(UserManager<ApplicationUser> userManager, RoleManager<ApplicationRole> roleManager)
    {
        _userManager = userManager;
        _roleManager = roleManager;
    }

    public async Task SeedAsync(CancellationToken cancellationToken = default)
    {
        if (await _userManager.FindByEmailAsync(AdminEmail) is not null)
        {
            return;
        }

        if (!await _roleManager.RoleExistsAsync(UserRole.SuperAdmin.ToString()))
        {
            await _roleManager.CreateAsync(new ApplicationRole { Name = UserRole.SuperAdmin.ToString() });
        }

        var user = new ApplicationUser
        {
            UserName = AdminEmail,
            Email = AdminEmail,
            EmailConfirmed = true,
            FirstName = "System",
            LastName = "Admin"
        };

        var result = await _userManager.CreateAsync(user, AdminPassword);
        if (!result.Succeeded)
        {
            return;
        }

        await _userManager.AddToRoleAsync(user, UserRole.SuperAdmin.ToString());
    }
}
