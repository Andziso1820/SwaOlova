@{
    ViewData["Title"] = "Deliveries Management";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1>@ViewData["Title"]</h1>
            <a href="@Url.Action("Map")" class="btn btn-info"><i class="fa fa-map"></i> View Map</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Total Deliveries</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">In Transit</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Completed</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <p class="text-muted small">Failed</p>
                <h4>0</h4>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <form class="form-inline" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search deliveries...">
                        <button type="submit" class="btn btn-info"><i class="fa fa-search"></i></button>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Delivery ID</th>
                            <th>Order</th>
                            <th>Rider</th>
                            <th>Status</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <p class="text-muted">No deliveries found.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
