using MediatR;
using SwaOlova.Application.Common.Interfaces.Repositories;
using SwaOlova.Application.Common.Models;
using SwaOlova.Application.Features.Promotions.Dtos;

namespace SwaOlova.Application.Features.Promotions.Queries.GetCouponByCode;

public sealed class GetCouponByCodeQueryHandler(
    IPromotionRepository promotionRepository)
    : IRequestHandler<GetCouponByCodeQuery, Result<CouponDto>>
{
    public async Task<Result<CouponDto>> Handle(GetCouponByCodeQuery request, CancellationToken cancellationToken)
    {
        var coupons = await couponRepository.GetAllAsync(cancellationToken);
        var coupon = coupons.FirstOrDefault(c => c.Code == request.CouponCode.ToUpper());

        if (coupon is null)
        {
            return Result<CouponDto>.Failure($"Coupon with code '{request.CouponCode}' was not found.");
        }

        var dto = PromotionDtoMapper.ToDto(coupon);
        return Result<CouponDto>.Success(dto);
    }
}
