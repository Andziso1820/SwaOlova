@model SwaOlova.Portal.Areas.Riders.Models.CreateRiderViewModel

@{
    ViewData["Title"] = "Add Rider";
}

<div class="campaign-details-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">Add Rider</h1>
            <p class="text-muted mb-0">Register a new rider. Riders start in Pending Approval status.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to riders</a>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">Rider Details</div>
                <div class="card-body">
                    <form method="post" asp-action="Create" asp-controller="Riders">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <partial name="_RiderFields" model="Model" />
                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Rider</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <aside class="card merchant-guide-card h-100">
                <div class="card-body">
                    <div class="merchant-guide-header mb-4">
                        <i class="fa fa-motorcycle fa-3x text-primary"></i>
                        <h4 class="mt-3">Rider Setup Tips</h4>
                        <p class="text-muted">Use this checklist to onboard riders quickly and accurately.</p>
                    </div>

                    <div class="guide-item">
                        <i class="fa fa-check-circle text-success"></i>
                        <div>
                            <strong>Use the legal full name</strong>
                            <p>Match the name on the rider's national ID and driver's license.</p>
                        </div>
                    </div>

                    <div class="guide-item">
                        <i class="fa fa-phone text-info"></i>
                        <div>
                            <strong>Verify contact details</strong>
                            <p>Ensure riders can receive calls and WhatsApp delivery updates.</p>
                        </div>
                    </div>

                    <div class="guide-item">
                        <i class="fa fa-id-card text-danger"></i>
                        <div>
                            <strong>Check license details</strong>
                            <p>Confirm the driver's license number and expiry date are valid.</p>
                        </div>
                    </div>

                    <div class="guide-item">
                        <i class="fa fa-file-text text-warning"></i>
                        <div>
                            <strong>Add vehicle and documents</strong>
                            <p>Register the vehicle and upload license, ID and vehicle documents from the workspace.</p>
                        </div>
                    </div>

                    <div class="guide-item">
                        <i class="fa fa-hourglass-half text-secondary"></i>
                        <div>
                            <strong>Approval process</strong>
                            <p>New riders are created in Pending Approval status and start Offline once approved.</p>
                        </div>
                    </div>

                    <div class="merchant-note">
                        <i class="fa fa-lightbulb-o"></i>
                        <span>
                            Swa Olava Tip: After creating a rider, immediately add their vehicle, upload documents and set their availability.
                        </span>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
