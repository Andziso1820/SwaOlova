@model SwaOlova.Portal.Areas.Merchants.Models.CreateMerchantViewModel

@{
    ViewData["Title"] = "Create Merchant";
}

<div class="merchant-create-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Create Merchant</h1>

        <a asp-action="Index"
           asp-area="Merchants"
           asp-controller="Merchants"
           class="btn btn-outline-secondary">

            Back To Merchants
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <form asp-action="Create"
                  method="post"
                  asp-area="Merchants"
                  asp-controller="Merchants"
                  class="card merchant-create-form-card h-100">

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <h5 class="section-heading">
                        Business Information
                    </h5>

                    <div class="mb-3">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               placeholder="e.g KFC Malamulele"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="ContactNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="ContactNumber"
                                   placeholder="0821234567"
                                   class="form-control" />

                            <span asp-validation-for="ContactNumber"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="MerchantCategoryId"
                                   class="form-label">
                            </label>

                            <select asp-for="MerchantCategoryId"
                                    class="form-select">

                                <option value="F077C437-CDE8-45CA-B726-BF5F3E95F5BD">
                                    Select Merchant Category
                                </option>

                                <option value="C2142F68-93DF-47E2-9686-769B75511104">
                                    Restaurant
                                </option>

                                <option value="16C452E6-C443-407B-A31D-D1C6A54269C6">
                                    Pharmacy
                                </option>

                                <option value="60EEB5F9-A21E-4DEA-8A2E-1848290D4011">
                                    Grocery Store
                                </option>

                                <option value="F16E4CB5-36AF-4070-904F-59E5D6AAB611">
                                    Butchery
                                </option>

                                <option value="9496C2D3-B703-4861-99C0-85D6AEA2BDC8">
                                    Fruit & Vegetable Shop
                                </option>

                                <option value="857A04C7-467F-4AAF-8BF1-CC4D75BCDD4C">
                                    Factory Shop
                                </option>

                            </select>
                            <span asp-validation-for="MerchantCategoryId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <h5 class="section-heading">
                        Location Information
                    </h5>

                    <div class="mb-3">

                        <label asp-for="AddressLine1"
                               class="form-label">
                        </label>

                        <input asp-for="AddressLine1"
                               placeholder="Street or landmark"
                               class="form-control" />

                        <span asp-validation-for="AddressLine1"
                              class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Village"
                               class="form-label">
                        </label>

                        <input asp-for="Village"
                               placeholder="Malamulele"
                               class="form-control" />

                        <span asp-validation-for="Village"
                              class="text-danger"></span>

                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="Latitude"
                                   class="form-label">
                            </label>

                            <input asp-for="Latitude"
                                   class="form-control" />

                            <span asp-validation-for="Latitude"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Longitude"
                                   class="form-label">
                            </label>

                            <input asp-for="Longitude"
                                   class="form-control" />

                            <span asp-validation-for="Longitude"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fa fa-save"></i>

                            Create Merchant

                        </button>

                        <a asp-action="Index"
                           asp-area="Merchants"
                           asp-controller="Merchants"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </div>

            </form>

        </div>

        <div class="col-lg-4">

            <aside class="card merchant-guide-card h-100">

                <div class="card-body">

                    <div class="merchant-guide-header mb-4">

                        <i class="fa fa-building fa-3x text-primary"></i>

                        <h4 class="mt-3">
                            Merchant Setup Tips
                        </h4>

                        <p class="text-muted">
                            Use this checklist to onboard merchants quickly and accurately.
                        </p>

                    </div>

                    <div class="guide-item">

                        <i class="fa fa-check-circle text-success"></i>

                        <div>

                            <strong>Use the official business name</strong>

                            <p>
                                Use the legal or trading name customers recognize.
                            </p>

                        </div>

                    </div>

                    <div class="guide-item">

                        <i class="fa fa-phone text-info"></i>

                        <div>

                            <strong>Verify contact details</strong>

                            <p>
                                Ensure merchants can receive calls and WhatsApp messages.
                            </p>

                        </div>

                    </div>

                    <div class="guide-item">

                        <i class="fa fa-map-marker text-danger"></i>

                        <div>

                            <strong>Capture accurate location</strong>

                            <p>
                                GPS coordinates improve delivery accuracy and rider routing.
                            </p>

                        </div>

                    </div>

                    <div class="guide-item">

                        <i class="fa fa-tags text-warning"></i>

                        <div>

                            <strong>Select the right category</strong>

                            <p>
                                Categories drive reporting and customer search results.
                            </p>

                        </div>

                    </div>

                    <div class="guide-item">

                        <i class="fa fa-hourglass-half text-secondary"></i>

                        <div>

                            <strong>Approval process</strong>

                            <p>
                                New merchants are created in Pending Approval status.
                            </p>

                        </div>

                    </div>

                    <div class="merchant-note">

                        <i class="fa fa-lightbulb-o"></i>

                        <span>

                            Swa Olava Tip: After creating a merchant,
                            immediately configure products, operating hours
                            and merchant users.

                        </span>

                    </div>

                </div>

            </aside>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}