@model SwaOlova.Portal.Areas.Riders.Models.RiderStatusViewModel

@{
    Layout = null;
}

<form method="post"
      asp-action="Reactivate"
      asp-controller="Riders"
      asp-area="Riders"
      asp-route-id="@Model.RiderId"
      data-campaign-modal-form="true"
      id="reactivateRiderForm">

    <partial name="_StatusFormFields" model="Model" />

    <div class="card merchant-guide-card">
        <div class="card-body">
            <div class="merchant-guide-header d-flex align-items-center mb-3">
                <div class="guide-icon-circle bg-success-subtle me-3">
                    <i class="fa fa-play-circle fa-lg text-success"></i>
                </div>

                <div>
                    <h5 class="mb-1">Rider Reactivation Guide</h5>
                    <p class="text-muted mb-0">
                        Follow these checks before restoring this rider to active operations.
                    </p>
                </div>
            </div>

            <div class="tip-card tip-success">
                <div class="tip-icon">
                    <i class="fa fa-user"></i>
                </div>

                <div>
                    <strong>Ready To Resume Deliveries</strong>
                    <p class="mb-0">
                        Reactivating <strong>@Model.RiderName</strong> restores access to rider operations and future dispatch readiness.
                    </p>
                </div>
            </div>

            <div class="tip-card tip-info">
                <div class="tip-icon">
                    <i class="fa fa-map-marker"></i>
                </div>

                <div>
                    <strong>Check Location & Contact Details</strong>
                    <p class="mb-0">
                        Confirm the rider's contact information and latest location details are still accurate before reactivation.
                    </p>
                </div>
            </div>

            <div class="tip-card tip-warning">
                <div class="tip-icon">
                    <i class="fa fa-file-text-o"></i>
                </div>

                <div>
                    <strong>Review Compliance Items</strong>
                    <p class="mb-0">
                        Ensure any suspended documents, vehicle details, or operational issues have been resolved.
                    </p>
                </div>
            </div>

            <div class="tip-card tip-purple">
                <div class="tip-icon">
                    <i class="fa fa-toggle-off"></i>
                </div>

                <div>
                    <strong>Returns Offline First</strong>
                    <p class="mb-0">
                        After reactivation, the rider returns to <strong>Offline</strong> status until availability is switched back on.
                    </p>
                </div>
            </div>

            <div class="mt-4">
                <label asp-for="Reason" class="form-label fw-bold">Reactivation Reason</label>
                <textarea asp-for="Reason"
                          class="form-control"
                          rows="4"
                          placeholder="Explain why the rider is being reactivated..."></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="tip-card tip-success mt-4">
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           id="confirmRiderReactivation"
                           data-enable-button="#reactivateRiderButton" />

                    <label class="form-check-label" for="confirmRiderReactivation">
                        I have verified the rider information and confirm that this rider is ready to resume operations on Swa Olava.
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                id="reactivateRiderButton"
                class="btn btn-success"
                disabled>
            <i class="fa fa-play-circle"></i>
            Activate Rider
        </button>
    </div>
</form>
