@model SwaOlova.Portal.Areas.Riders.Models.RiderDetailsViewModel

<form method="post" asp-action="UpdateLocation" asp-controller="Riders" asp-route-id="@Model.Rider.Id" data-campaign-modal-form="true">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Latitude" class="form-label">Latitude</label>
            <input asp-for="Latitude" type="number" step="0.000001" class="form-control" placeholder="-90 to 90" />
            <span asp-validation-for="Latitude" class="text-danger"></span>
            <small class="text-muted d-block mt-1">Range: -90 to 90</small>
        </div>

        <div class="col-md-6">
            <label asp-for="Longitude" class="form-label">Longitude</label>
            <input asp-for="Longitude" type="number" step="0.000001" class="form-control" placeholder="-180 to 180" />
            <span asp-validation-for="Longitude" class="text-danger"></span>
            <small class="text-muted d-block mt-1">Range: -180 to 180</small>
        </div>
    </div>

    @if (Model.Rider.CurrentLocation is not null)
    {
        <div class="alert alert-info mt-3 mb-3">
            <strong>Current location:</strong><br />
            Latitude: @Model.Rider.CurrentLocation.Latitude.ToString("F6")<br />
            Longitude: @Model.Rider.CurrentLocation.Longitude.ToString("F6")<br />
            <small class="text-muted">Updated: @Model.Rider.CurrentLocation.RecordedAt.ToString("dd MMM yyyy HH:mm")</small>
        </div>
    }

    <button type="submit" class="btn btn-primary btn-sm mt-3">Update Location</button>
</form>
